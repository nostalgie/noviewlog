// Slint chrome: single CSD title bar (logo + in-bar menus + drag gap + captions)
// + terminals sidebar + tab strip + viewport.
// Dark theme via Palette + fluent style; Theme holds app chrome colors.
// Client-side decorations: no-frame, custom caption strip, deferred title-bar drag
// (gap only), double-click maximize, thin winit resize-border.
// Native MenuBar is not used — Slint forces it above Window body children.

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TabInfo, TerminalInfo, FilterInfo, ProjectInfo } from "types.slint";
import { CtxAccelMenuItem, ModeToggle } from "chrome-menus.slint";
import { TitleBar } from "title-bar.slint";
import { StatusBar } from "status-bar.slint";
import {
    TabChip,
    FilterRow,
    TerminalRow,
    TerminalRowIcon,
    SidebarSectionHeader,
    EngineScrollBar,
} from "sidebar.slint";
import { ProjectsDialog } from "projects-dialog.slint";
import { FindBar } from "find-bar.slint";
import {
    EditLaunchDialog,
    SettingsDialog,
    AboutDialog,
    QuitConfirmDialog,
} from "app-dialogs.slint";

// Bundled proportional UI face (OFL) — matches Linux Noto look on Windows.
// NOT Mono: never use NotoSansMono / Cascadia Mono for chrome text.
import "../../../assets/NotoSans-Regular.ttf";
import "../../../assets/NotoSans-Bold.ttf";

export { TabInfo, TerminalInfo, FilterInfo, ProjectInfo }

export component AppWindow inherits Window {
    title: "NoViewLog";
    // OS-level window icon (Windows taskbar; Linux best-effort).
    icon: @image-url("assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 500px;
    // Proportional chrome (menus, sidebar, dialogs, AppButton). Viewport bitmap
    // fonts are separate (fontdue / load_mono_font).
    default-font-family: "Noto Sans";
    // Client-side decorations (frameless window + custom caption strip).
    no-frame: true;
    // Edge/corner drag-resize. Keep thin so the top grip barely overlaps the 32px
    // menu strip (5px was stealing clicks on File/View/Tab labels).
    resize-border-width: root.maximized ? 0px : Theme.resize-border;
    background: Theme.bg-window;
    forward-focus: viewport-host;

    in-out property <image> viewport-image;
    in-out property <string> status-text: "ready";
    // Live "current / total" line counter (right side of status bar).
    in-out property <string> line-position-text: "";
    // FILES filter scan hit the match-offset cap: persistent truncation hint
    // (disc + text, issue #150). Engine clears it on the next scan/invalidate.
    in-out property <bool> matches-capped: false;
    in-out property <[TabInfo]> tabs-model;
    in-out property <int> active-tab-index: 0;
    in-out property <bool> can-restore-tab: false;
    in-out property <[TerminalInfo]> terminals-model;
    in-out property <[TerminalInfo]> files-model;
    in-out property <[ProjectInfo]> projects-model;
    in-out property <string> active-project-id: "";
    in-out property <string> active-project-name: "";
    in-out property <int> active-terminal-index: 0;
    // Active session is a read-only log file (hide Follow; primary tab = filename).
    in-out property <bool> is-file-session: false;
    // Stopped live Terminal: one-line launch summary above the viewport.
    in-out property <bool> show-launch-preview: false;
    in-out property <string> launch-preview-text: "";
    in-out property <bool> terminals-section-expanded: true;
    in-out property <bool> files-section-expanded: true;
    in property <bool> host-is-windows: false;

    // Per-tab IN/OUT filters (hidden / no-op on the Terminal tab; engine rejects those filters).
    in-out property <[FilterInfo]> filters-model;
    in-out property <string> filter-draft: "";
    // Draft regex mode for next Include/Exclude (default literal).
    in-out property <bool> filter-draft-regex: false;
    in-out property <bool> filters-editable: false;

    // VS Code–style floating find bar (over log viewport).
    in-out property <bool> find-open: false;
    in-out property <string> find-query: "";
    in-out property <bool> find-case-sensitive: false;
    in-out property <bool> find-whole-word: false;
    in-out property <bool> find-regex: false;
    in-out property <string> find-status: "";
    in-out property <string> find-error: "";
    in-out property <bool> find-focus-request: false;

    // Engine scroll chrome (device-pixel units from stats).
    in-out property <float> scroll-y: 0.0;
    in-out property <float> max-scroll-y: 0.0;
    in-out property <float> scroll-x: 0.0;
    in-out property <float> max-scroll-x: 0.0;
    in-out property <float> viewport-page-h: 1.0;
    in-out property <float> viewport-page-w: 1.0;
    in-out property <bool> show-hscroll: false;

    // Terminal tab block caret overlay (host-drawn; blink does not repaint the log Image).
    in-out property <bool> caret-visible: false;
    in-out property <bool> caret-blink-on: true;
    in-out property <float> caret-x: 0.0;
    in-out property <float> caret-y: 0.0;
    in-out property <float> caret-w: 0.0;
    in-out property <float> caret-h: 0.0;

    // Viewport context menu (Copy / Paste) enable flags — refreshed from Rust.
    in-out property <bool> can-copy: false;
    in-out property <bool> can-paste: false;
    // PopupWindow forbids setting x/y from outside; bind position via these.
    property <length> viewport-menu-x: 0px;
    property <length> viewport-menu-y: 0px;

    // Chrome list scroll (logical px); Flickable viewport-x/y are negative offsets.
    in-out property <float> terminals-scroll-y: 0.0;
    in-out property <float> files-scroll-y: 0.0;
    in-out property <float> tabs-scroll-x: 0.0;
    // Bar visibility flags — set from Flickable `changed` callbacks only.
    // Never bind `if *-scroll-max()` into a layout that feeds that same max
    // (layoutinfo cycle via flick width/height).
    property <bool> terminals-bar-visible: false;
    property <bool> files-bar-visible: false;
    property <bool> tabs-bar-visible: false;

    // Drag-reorder session (terminals sidebar / filter tabs).
    property <bool> term-dragging: false;
    property <string> term-drag-id: "";
    property <int> term-drag-from: -1;
    property <int> term-drop-to: -1;
    property <bool> file-dragging: false;
    property <string> file-drag-id: "";
    property <int> file-drag-from: -1;
    property <int> file-drop-to: -1;
    property <bool> tab-dragging: false;
    property <int> tab-drag-from: -1;
    property <int> tab-drop-to: -1;
    // Visual insert-before index in the current strip (n = after last chip).
    property <int> tab-drop-gap: -1;
    property <bool> tab-drop-line-visible: false;
    property <length> tab-drop-line-x: 0px;
    property <length> tab-drop-line-y: 0px;
    property <length> tab-drag-preview-x: 0px;
    property <length> tab-drag-preview-y: 0px;
    property <string> tab-drag-title: "";

    callback viewport-resized(width: length, height: length);
    callback viewport-focused(focused: bool);
    callback key-event(text: string, control: bool, meta: bool, alt: bool, shift: bool) -> bool;
    callback viewport-scrolled(delta-y: float);
    callback viewport-scrolled-x(delta-x: float);
    callback viewport-scroll-y-changed(value: float);
    callback viewport-scroll-x-changed(value: float);
    callback viewport-scrollbar-drag-active(active: bool);
    // Pointer over the log bitmap: button 0=left, 1=middle, 2=right; kind 0=down, 1=up, 2=move.
    callback viewport-pointer(x: float, y: float, button: int, kind: int);
    // Right-click menu: refresh enable flags, then Copy / Paste actions.
    callback viewport-context-opening();
    callback viewport-copy();
    callback viewport-paste();

    callback tab-switch(index: int);
    callback tab-add();
    callback tab-close(index: int);
    callback tab-restore();
    callback tab-rename(index: int, name: string);
    callback tab-move(from-index: int, to-index: int);

    callback terminal-switch(id: string);
    callback terminal-add();
    callback terminal-close(id: string);
    callback terminal-move(id: string, to-index: int);
    callback terminal-rename(id: string, name: string);
    callback terminal-start(id: string);
    callback terminal-stop(id: string);
    callback set-sidebar-expanded(terminals: bool, files: bool);

    callback project-open(id: string);
    callback project-create(name: string);
    callback project-rename(id: string, name: string);
    callback project-delete(id: string);
    callback program-set-launch(terminal-id: string, command: string, args-text: string, cwd: string, wsl: bool, wsl-distro: string);

    // IN/OUT filters → engine filter_add / filter_toggle / filter_remove / filter_update / filter_clear.
    // filter-type is "include" or "exclude"; use-regex is the draft `.*` toggle.
    callback filter-add(filter-type: string, pattern: string, use-regex: bool);
    callback filter-toggle(id: string, enabled: bool);
    callback filter-remove(id: string);
    callback filter-update(id: string, pattern: string);
    callback filter-clear();
    // FILTERS draft preview → engine filter_draft_set (debounced in Rust).
    callback filter-draft-changed(pattern: string, use-regex: bool);

    // Find panel → engine search_set / search_goto (debounced in Rust).
    callback find-query-changed(query: string, regex: bool, case-sensitive: bool, whole-word: bool);
    callback find-goto(delta: int);
    // Flush pending search_set (focus left the Find field / toggles).
    callback find-commit();
    // Hide Find: drop pending search_set and clear engine query (highlights + follow).
    callback find-closed();

    // View menu → engine commands (bitmap font zoom + wrap + follow).
    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback set-wrap-lines(wrap: bool);
    callback set-follow(follow: bool);
    // Severity reading mode → engine severity_set (`all`/`error`/`warn`/`info`/`debug`/`unleveled`).
    callback set-severity(mode: string);
    // Multiline Record expand/collapse → engine records_expand_all / records_collapse_all.
    callback records-expand-all();
    callback records-collapse-all();
    // Ctrl/Meta + wheel over the log viewport → zoom (delta-y > 0 zooms in).
    callback viewport-zoom-wheel(delta-y: float);

    // File → Open log file… / Settings… (engine load_file / set_settings).
    callback open-log-file();
    callback reload-file(id: string);
    callback settings-apply(max-scrollback-lines: int);
    // About → Slint attribution link (https://slint.dev).
    callback open-url(url: string);

    // Title-strip drag → Rust calls winit::Window::drag_window.
    // Only the empty stretch between menus and caption buttons invokes this.
    callback title-bar-drag();

    // Synced from engine stats (View → Follow / Wrap / Horizontal scroll checkmarks).
    // Callback set-follow → engine SetFollow / stats auto_follow / property auto-follow.
    // Engine default auto_follow / wrap_lines: true — init checked; stats overwrite on first flush.
    in-out property <bool> auto-follow: true;
    in-out property <bool> wrap-lines: true;
    // Active Tab/View severity filter (`all`, `error`, `warn`, `info`, `debug`, `unleveled`).
    in-out property <string> severity-mode: "all";
    // Max retained log lines (engine max_scrollback_lines); Settings edits a draft.
    in-out property <int> max-scrollback-lines: 10000;
    property <int> settings-draft: 10000;
    // Tab menu enablement (Terminal tab + last-tab guards).
    in-out property <bool> can-close-tab: false;
    in-out property <bool> can-rename-tab: true;
    // Inline rename session (-1 = idle). Draft lives here so chips stay in sync.
    in-out property <int> renaming-tab-index: -1;
    in-out property <string> rename-draft: "";
    // Terminal row rename (empty id = idle); shares rename-draft while active.
    in-out property <string> renaming-terminal-id: "";

    pure function is-renaming() -> bool {
        root.renaming-tab-index >= 0 || root.renaming-terminal-id != ""
    }

    // Menubar "armed": any top-level chrome menu is open → hover switches via
    // menu-bar-pointer-moved (winit), not TouchArea has-hover (blocked by Popup).
    out property <bool> menu-bar-active: title-bar.menu-bar-active;

    pure function terminals-scroll-max() -> float {
        max(0.0, (term-flick.viewport-height - term-flick.height) / 1px)
    }

    pure function files-scroll-max() -> float {
        max(0.0, (files-flick.viewport-height - files-flick.height) / 1px)
    }

    pure function tabs-scroll-max() -> float {
        max(0.0, (tab-flick.viewport-width - tab-flick.width) / 1px)
    }

    // TerminalRow height + gap (Theme.terminal-row-*). Cap visible rows so TERMINALS/FILES
    // keep stable heights and do not fight each other (or FILTERS) for stretch.
    pure function sidebar-list-height(count: int, expanded: bool) -> length {
        if (!expanded || count <= 0) {
            return 0px;
        }
        let n = min(count, 5);
        return n * Theme.terminal-row-height + max(0, n - 1) * Theme.terminal-row-gap;
    }

    function toggle-terminals-section() {
        root.terminals-section-expanded = !root.terminals-section-expanded;
        root.set-sidebar-expanded(root.terminals-section-expanded, root.files-section-expanded);
    }

    function toggle-files-section() {
        root.files-section-expanded = !root.files-section-expanded;
        root.set-sidebar-expanded(root.terminals-section-expanded, root.files-section-expanded);
    }

    // File → Projects overlay drafts (bound into the PopupWindow child).
    property <string> projects-dialog-mode: "list";
    property <string> projects-name-draft: "";
    property <string> projects-rename-id: "";

    // Edit-launch dialog drafts.
    property <string> launch-edit-terminal-id: "";
    property <string> launch-command-draft: "";
    property <string> launch-args-draft: "";
    property <string> launch-cwd-draft: "";
    property <bool> launch-wsl-draft: false;
    property <string> launch-wsl-distro-draft: "";

    function open-edit-launch(term-id: string, command: string, args-text: string, cwd: string, wsl: bool, wsl-distro: string) {
        root.launch-edit-terminal-id = term-id;
        root.launch-command-draft = command;
        root.launch-args-draft = args-text;
        root.launch-cwd-draft = cwd;
        root.launch-wsl-draft = wsl;
        root.launch-wsl-distro-draft = wsl-distro;
        edit-launch-dlg.show();
    }

    function confirm-edit-launch() {
        root.program-set-launch(
            root.launch-edit-terminal-id,
            root.launch-command-draft,
            root.launch-args-draft,
            root.launch-cwd-draft,
            root.launch-wsl-draft,
            root.launch-wsl-distro-draft
        );
        edit-launch-dlg.close();
    }

    // Invoked from Rust on CursorMoved while a chrome menu may be open.
    // TitleBar owns the button rects (hit-tested at call time).
    public function menu-bar-pointer-moved(x: float, y: float) {
        title-bar.menu-bar-pointer-moved(x, y);
    }

    // PopupWindow blocks press on the title-bar drag TouchArea. Rust calls this on
    // MouseInput while a chrome menu is open; returns true if the press hit the
    // drag gap (menus closed — same gesture can then start window drag after slop).
    public function title-bar-chrome-press(x: float, y: float) -> bool {
        return title-bar.chrome-press(x, y);
    }

    function sync-terminals-bar-visible() {
        root.terminals-bar-visible = root.terminals-scroll-max() > 0.5;
    }

    function sync-tabs-bar-visible() {
        root.tabs-bar-visible = root.tabs-scroll-max() > 0.5;
    }

    function scroll-tabs-by(delta-y: float) {
        // Wheel up (positive delta-y) → reveal tabs on the left.
        // Always set both the model property and Flickable — assigning viewport-x
        // breaks a one-way binding from tabs-scroll-x.
        root.tabs-scroll-x = clamp(root.tabs-scroll-x - delta-y, 0.0, root.tabs-scroll-max());
        root.clamp-tabs-scroll();
    }

    // Same shrink case as clamp-terminals-scroll (last tab closed).
    function clamp-tabs-scroll() {
        root.tabs-scroll-x = clamp(root.tabs-scroll-x, 0.0, root.tabs-scroll-max());
        tab-flick.viewport-x = -root.tabs-scroll-x * 1px;
        root.sync-tabs-bar-visible();
    }

    function scroll-terminals-by(delta-y: float) {
        // Wheel up (positive delta-y) → scroll content up / reveal upper rows.
        root.terminals-scroll-y = clamp(root.terminals-scroll-y - delta-y, 0.0, root.terminals-scroll-max());
        root.clamp-terminals-scroll();
    }

    // Model shrink (terminal close) can leave the stored offset past the new
    // max — re-clamp on Flickable geometry change, not only on scroll-by.
    function clamp-terminals-scroll() {
        root.terminals-scroll-y = clamp(root.terminals-scroll-y, 0.0, root.terminals-scroll-max());
        term-flick.viewport-y = -root.terminals-scroll-y * 1px;
        root.sync-terminals-bar-visible();
    }

    function sync-files-bar-visible() {
        root.files-bar-visible = root.files-scroll-max() > 0.5;
    }

    function scroll-files-by(delta-y: float) {
        root.files-scroll-y = clamp(root.files-scroll-y - delta-y, 0.0, root.files-scroll-max());
        root.clamp-files-scroll();
    }

    // Same shrink case as clamp-terminals-scroll (last file closed).
    function clamp-files-scroll() {
        root.files-scroll-y = clamp(root.files-scroll-y, 0.0, root.files-scroll-max());
        files-flick.viewport-y = -root.files-scroll-y * 1px;
        root.sync-files-bar-visible();
    }

    // Row pitch: Theme.terminal-row-pitch (TerminalRow height + terms-col gap).
    function update-term-drop(abs-y: length) {
        let n = root.terminals-model.length;
        if (n < 2 || !root.term-dragging) {
            return;
        }
        // `terms-col.absolute-position` already reflects the Flickable's
        // viewport shift (viewport-y = -scroll-y), so the content-space
        // coordinate is (abs-y - origin) alone; adding the scroll offset
        // double-counted it and dragged to the wrong row when scrolled.
        let origin = terms-col.absolute-position.y;
        let y_px = (abs-y - origin) / 1px;
        let raw = floor(y_px / (Theme.terminal-row-pitch / 1px));
        root.term-drop-to = max(0, min(n - 1, raw));
    }

    function finish-term-drag() {
        if (root.term-dragging && root.term-drag-from >= 0 && root.term-drop-to >= 0
            && root.term-drop-to != root.term-drag-from && root.term-drag-id != "") {
            root.terminal-move(root.term-drag-id, root.term-drop-to);
        }
        root.term-dragging = false;
        root.term-drag-id = "";
        root.term-drag-from = -1;
        root.term-drop-to = -1;
    }

    function update-tab-drop(local-x: length, local-y: length) {
        // local-* = pointer in tabs-row content space. Window = flick origin + content + viewport.
        root.tab-drag-preview-x = tab-flick.absolute-position.x + local-x + tab-flick.viewport-x;
        root.tab-drag-preview-y = tab-flick.absolute-position.y + local-y + tab-flick.viewport-y;
        let n = root.tabs-model.length;
        if (n < 2 || !root.tab-dragging || root.tab-drag-from < 1) {
            root.tab-drop-line-visible = false;
            return;
        }
        // Chip pitch must equal TabChip preferred-width (sidebar.slint).
        // Guarded cross-file by tests/tab_chip_pitch_wiring.rs — changing one
        // without the other fails that test.
        let pitch = 120.0;
        let x_px = local-x / 1px;
        let raw_slot = floor(x_px / pitch);
        let into = x_px - raw_slot * pitch;
        let gap_raw = into < pitch * 0.5 ? raw_slot : raw_slot + 1;
        let gap = max(1, min(n, gap_raw));
        root.tab-drop-gap = gap;
        let dest = root.tab-drag-from < gap ? gap - 1 : gap;
        root.tab-drop-to = max(1, min(n - 1, dest));
        root.tab-drop-line-visible = root.tab-drop-to != root.tab-drag-from;
        root.tab-drop-line-x = tab-flick.absolute-position.x + (gap * pitch) * 1px + tab-flick.viewport-x - 1px;
        root.tab-drop-line-y = tab-flick.absolute-position.y;
    }

    function finish-tab-drag() {
        if (root.tab-dragging && root.tab-drag-from >= 1 && root.tab-drop-to >= 1
            && root.tab-drop-to != root.tab-drag-from) {
            root.tab-move(root.tab-drag-from, root.tab-drop-to);
        }
        root.tab-dragging = false;
        root.tab-drag-from = -1;
        root.tab-drop-to = -1;
        root.tab-drop-gap = -1;
        root.tab-drop-line-visible = false;
        root.tab-drag-preview-x = 0px;
        root.tab-drag-preview-y = 0px;
        root.tab-drag-title = "";
    }

    init => {
        Palette.color-scheme = ColorScheme.dark;
        // Ensure the Terminal tab can accept keys and show the caret without a priming click.
        viewport-host.focus();
    }

    // Called from Rust after handlers are wired (init focus may race before callbacks exist).
    public function focus-viewport() {
        viewport-host.focus();
    }

    // Dismisses inline rename, closes every title-bar menu (TitleBar owns the popups).
    function close-chrome-menus() {
        title-bar.close-chrome-menus();
    }

    function start-tab-rename(index: int) {
        if (index < 0 || index >= root.tabs-model.length) {
            return;
        }
        // The Terminal tab is a fixed system tab — never enter inline rename.
        if (root.tabs-model[index].is-terminal-tab) {
            return;
        }
        // Abort any stuck reorder so drop markers cannot linger during rename.
        root.finish-tab-drag();
        root.end-terminal-rename();
        root.renaming-tab-index = index;
        root.rename-draft = root.tabs-model[index].name;
    }

    function end-tab-rename() {
        root.renaming-tab-index = -1;
        if (root.renaming-terminal-id == "") {
            root.rename-draft = "";
        }
    }

    // Click-away from viewport/find while rename re-focuses would leave stuck editors.
    function dismiss-tab-rename-if-any() {
        if (root.renaming-tab-index < 0) {
            return;
        }
        root.commit-tab-rename(root.renaming-tab-index, root.rename-draft);
    }

    function dismiss-terminal-rename-if-any() {
        if (root.renaming-terminal-id == "") {
            return;
        }
        root.commit-terminal-rename(root.renaming-terminal-id, root.rename-draft);
    }

    function dismiss-any-rename-if-any() {
        root.dismiss-tab-rename-if-any();
        root.dismiss-terminal-rename-if-any();
    }

    // Empty-strip double-click → new tab. Must not be blocked by stuck TERMINALS rename
    // (`is-renaming()` ORs both). Dismiss any rename, then tab-add.
    function gutter-request-tab-add() {
        root.dismiss-any-rename-if-any();
        root.tab-add();
    }

    function commit-tab-rename(index: int, name: string) {
        if (index < 0) {
            root.end-tab-rename();
            return;
        }
        root.tab-rename(index, name);
        root.end-tab-rename();
    }

    function start-terminal-rename(id: string, label: string) {
        if (id == "") {
            return;
        }
        root.finish-term-drag();
        root.end-tab-rename();
        root.renaming-terminal-id = id;
        root.rename-draft = label;
    }

    function end-terminal-rename() {
        root.renaming-terminal-id = "";
        if (root.renaming-tab-index < 0) {
            root.rename-draft = "";
        }
    }

    function commit-terminal-rename(id: string, name: string) {
        if (id == "") {
            root.end-terminal-rename();
            return;
        }
        root.terminal-rename(id, name);
        root.end-terminal-rename();
    }

    function open-projects() {
        root.close-chrome-menus();
        root.projects-dialog-mode = "list";
        root.projects-name-draft = "";
        root.projects-rename-id = "";
        projects-dlg.show();
    }

    function close-projects() {
        projects-dlg.close();
    }

    function open-settings() {
        root.close-chrome-menus();
        root.settings-draft = root.max-scrollback-lines;
        settings-dlg.show();
    }

    function close-settings() {
        settings-dlg.close();
    }

    function confirm-settings() {
        root.settings-apply(root.settings-draft);
        settings-dlg.close();
    }

    function open-about() {
        root.close-chrome-menus();
        about-dlg.show();
    }

    function close-about() {
        about-dlg.close();
    }

    function close-quit-confirm() {
        quit-dlg.close();
    }

    // Called from Rust `on_close_requested` (caption X, File → Exit, Alt+F4).
    public function open-quit-confirm() {
        root.close-chrome-menus();
        projects-dlg.close();
        edit-launch-dlg.close();
        settings-dlg.close();
        about-dlg.close();
        quit-dlg.show();
    }

    function confirm-quit() {
        quit-dlg.close();
        root.hide();
    }

    // 1px CSD outline (Theme.window-border) — keeps frameless window distinct from neighbors.
    // Hidden when maximized so the edge sits flush with the screen.
    csd-frame := Rectangle {
        border-width: root.maximized ? 0px : 1px;
        border-color: Theme.window-border;
        background: Theme.bg-window;

        VerticalLayout {
            spacing: 0px;
            // Inset content so the 1px border isn't painted over (Slint draws border inside).
            padding: root.maximized ? 0px : 1px;

            // Single CSD strip: [Logo] [File] [View] [Tab] [Help] .... [min] [max] [close]
            // Native MenuBar omitted — it cannot sit inside this strip.
            title-bar := TitleBar {
                maximized: root.maximized;
                is-file-session: root.is-file-session;
                auto-follow: root.auto-follow;
                wrap-lines: root.wrap-lines;
                severity-mode: root.severity-mode;
                can-close-tab: root.can-close-tab;
                can-restore-tab: root.can-restore-tab;
                can-rename-tab: root.can-rename-tab;
                dismiss-rename => { root.dismiss-any-rename-if-any(); }
                open-log-file => { root.open-log-file(); }
                reload-file => { root.reload-file(""); }
                projects-requested => { root.open-projects(); }
                settings-requested => { root.open-settings(); }
                about-requested => { root.open-about(); }
                exit-requested => { root.close(); }
                set-follow(follow) => { root.set-follow(follow); }
                set-wrap-lines(wrap) => { root.set-wrap-lines(wrap); }
                set-severity(mode) => { root.set-severity(mode); }
                records-expand-all => { root.records-expand-all(); }
                records-collapse-all => { root.records-collapse-all(); }
                zoom-in => { root.zoom-in(); }
                zoom-out => { root.zoom-out(); }
                zoom-reset => { root.zoom-reset(); }
                close-tab-requested => { root.tab-close(root.active-tab-index); }
                restore-tab-requested => { root.tab-restore(); }
                rename-tab-requested => { root.start-tab-rename(root.active-tab-index); }
                minimize-requested => { root.minimized = true; }
                maximize-toggled => { root.maximized = !root.maximized; }
                window-close-requested => { root.close(); }
                drag-requested => { root.title-bar-drag(); }
            }

            HorizontalLayout {
                spacing: 0px;
                padding: 0px;
                vertical-stretch: 1;

                // Left terminals sidebar — FocusScope so clicks steal focus from the viewport
                // (stops caret blink / keeps idle timer slow when interacting with chrome).
                HorizontalLayout {
                    spacing: 0px;

                    FocusScope {
                        width: 260px;
                        // While a tab/terminal rename TextInput is focused, do not steal focus on
                        // press/interaction in the sidebar (would blur and fight rename retention).
                        focus-on-click: !root.is-renaming();

                        changed has-focus => {
                            // Viewport / tab strip took focus — commit inline rename.
                            if (!self.has-focus) {
                                root.dismiss-any-rename-if-any();
                            }
                        }

                        key-pressed(_event) => { reject }

                        Rectangle {
                            background: Theme.bg-panel;

                            // Pad T/B; TERMINALS/FILES headers keep 8–12px L. Rows indent via
                            // TerminalRow padding so ● aligns under section titles (not chevrons).
                            VerticalLayout {
                                padding-left: 0px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                padding-right: 0px;
                                spacing: 8px;

                                if root.active-project-name != "": HorizontalLayout {
                                    height: 20px;
                                    padding-left: 12px;
                                    padding-right: 12px;

                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.active-project-name;
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: 700;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                // TERMINALS — collapsible live PTY sessions
                                SidebarSectionHeader {
                                    label: "TERMINALS";
                                    dot-color: Theme.accent;
                                    expanded: root.terminals-section-expanded;
                                    toggled => { root.dismiss-any-rename-if-any(); root.toggle-terminals-section(); }
                                    add-clicked => {
                                        root.dismiss-any-rename-if-any();
                                        root.terminal-add();
                                    }
                                }

                                term-list := Rectangle {
                                    height: root.sidebar-list-height(
                                        root.terminals-model.length,
                                        root.terminals-section-expanded
                                    );
                                    vertical-stretch: 0;
                                    clip: true;
                                    background: transparent;

                                    term-flick := Flickable {
                                        width: 100%;
                                        height: 100%;
                                        viewport-width: self.width;
                                        viewport-height: max(self.height, terms-col.preferred-height);
                                        viewport-y: -root.terminals-scroll-y * 1px;
                                        interactive: true;

                                        changed viewport-y => {
                                            root.terminals-scroll-y = clamp(-self.viewport-y / 1px, 0.0, root.terminals-scroll-max());
                                        }
                                        // A window resize shrinks the Flickable itself;
                                        // re-clamp so the offset never stays past max.
                                        changed height => {
                                            root.sync-terminals-bar-visible();
                                            root.clamp-terminals-scroll();
                                        }
                                        changed viewport-height => { root.clamp-terminals-scroll(); }

                                        terms-col := VerticalLayout {
                                            spacing: Theme.terminal-row-gap;
                                            alignment: start;
                                            width: 100%;

                                            for term in root.terminals-model: TerminalRow {
                                                title: term.label;
                                                subtitle: term.cwd == "" ? "." : term.cwd;
                                                running: term.running;
                                                active: term.index == root.active-terminal-index;
                                                show-close: root.terminals-model.length > 1;
                                                show-edit-launch: true;
                                                show-run-stop: term.has-launch;
                                                can-rename: true;
                                                status-dot-color: term.running ? Theme.accent : Theme.text-muted;
                                                term-id: term.id;
                                                term-index: term.index;
                                                show-drop-before: root.term-dragging
                                                    && root.term-drop-to == term.index
                                                    && root.term-drop-to != root.term-drag-from;
                                                dim-as-drag-source: root.term-dragging && root.term-drag-id == term.id;
                                                renaming: root.renaming-terminal-id != "" && root.renaming-terminal-id == term.id;
                                                rename-text: root.rename-draft;
                                                activated => {
                                                    root.dismiss-any-rename-if-any();
                                                    root.terminal-switch(term.id);
                                                }
                                                close-clicked => {
                                                    root.dismiss-any-rename-if-any();
                                                    root.terminal-close(term.id);
                                                }
                                                run-clicked => {
                                                    root.dismiss-any-rename-if-any();
                                                    root.terminal-start(term.id);
                                                }
                                                stop-clicked => {
                                                    root.dismiss-any-rename-if-any();
                                                    root.terminal-stop(term.id);
                                                }
                                                edit-launch-clicked => {
                                                    root.dismiss-any-rename-if-any();
                                                    root.open-edit-launch(
                                                        term.id,
                                                        term.launch-command,
                                                        term.launch-args,
                                                        term.launch-cwd,
                                                        term.launch-wsl,
                                                        term.launch-wsl-distro
                                                    );
                                                }
                                                wheel(dy) => { root.scroll-terminals-by(dy); }
                                                rename-requested => {
                                                    root.terminal-switch(term.id);
                                                    root.start-terminal-rename(term.id, term.label);
                                                }
                                                rename-edited(text) => {
                                                    root.rename-draft = text;
                                                }
                                                rename-accepted(text) => {
                                                    root.commit-terminal-rename(term.id, text);
                                                }
                                                rename-cancelled => {
                                                    root.end-terminal-rename();
                                                }
                                                reorder-drag-start(id, from-index) => {
                                                    root.term-dragging = true;
                                                    root.term-drag-id = id;
                                                    root.term-drag-from = from-index;
                                                    root.term-drop-to = from-index;
                                                }
                                                reorder-drag-move(abs-y) => { root.update-term-drop(abs-y); }
                                                reorder-drag-end => { root.finish-term-drag(); }
                                            }
                                        }
                                    }

                                    if root.terminals-bar-visible: EngineScrollBar {
                                        x: parent.width - 10px;
                                        width: 10px;
                                        height: 100%;
                                        z: 20;
                                        horizontal: false;
                                        value <=> root.terminals-scroll-y;
                                        maximum: root.terminals-scroll-max();
                                        page-size: max(1.0, term-flick.height / 1px);
                                        press() => { root.dismiss-any-rename-if-any(); }
                                        scrolled(v) => {
                                            term-flick.viewport-y = -v * 1px;
                                        }
                                    }
                                }

                                // FILES — collapsible log-file sessions
                                SidebarSectionHeader {
                                    label: "FILES";
                                    dot-color: Theme.include;
                                    expanded: root.files-section-expanded;
                                    toggled => { root.dismiss-any-rename-if-any(); root.toggle-files-section(); }
                                    add-clicked => {
                                        root.dismiss-any-rename-if-any();
                                        root.open-log-file();
                                    }
                                }

                                files-list := Rectangle {
                                    height: root.sidebar-list-height(
                                        root.files-model.length,
                                        root.files-section-expanded
                                    );
                                    vertical-stretch: 0;
                                    clip: true;
                                    background: transparent;

                                    files-flick := Flickable {
                                        width: 100%;
                                        height: 100%;
                                        viewport-width: self.width;
                                        viewport-height: max(self.height, files-col.preferred-height);
                                        viewport-y: -root.files-scroll-y * 1px;
                                        interactive: true;

                                        changed viewport-y => {
                                            root.files-scroll-y = clamp(-self.viewport-y / 1px, 0.0, root.files-scroll-max());
                                        }
                                        // Window-resize shrink path must re-clamp too.
                                        changed height => {
                                            root.sync-files-bar-visible();
                                            root.clamp-files-scroll();
                                        }
                                        changed viewport-height => { root.clamp-files-scroll(); }

                                        files-col := VerticalLayout {
                                            spacing: Theme.terminal-row-gap;
                                            alignment: start;
                                            width: 100%;

                                            for file in root.files-model: TerminalRow {
                                                title: file.label;
                                                subtitle: file.cwd == "" ? "." : file.cwd;
                                                running: false;
                                                active: file.index == root.active-terminal-index;
                                                show-close: true;
                                                show-refresh: true;
                                                can-rename: false;
                                                status-dot-color: Theme.include;
                                                term-id: file.id;
                                                term-index: file.index;
                                                show-drop-before: false;
                                                dim-as-drag-source: false;
                                                renaming: false;
                                                rename-text: "";
                                                activated => {
                                                    root.dismiss-any-rename-if-any();
                                                    root.terminal-switch(file.id);
                                                }
                                                close-clicked => {
                                                    root.dismiss-any-rename-if-any();
                                                    root.terminal-close(file.id);
                                                }
                                                refresh-clicked => {
                                                    root.dismiss-any-rename-if-any();
                                                    root.reload-file(file.id);
                                                }
                                                wheel(dy) => { root.scroll-files-by(dy); }
                                                reorder-drag-start(id, from-index) => { }
                                                reorder-drag-move(abs-y) => { }
                                                reorder-drag-end => { }
                                            }
                                        }
                                    }

                                    if root.files-bar-visible: EngineScrollBar {
                                        x: parent.width - 10px;
                                        width: 10px;
                                        height: 100%;
                                        z: 20;
                                        horizontal: false;
                                        value <=> root.files-scroll-y;
                                        maximum: root.files-scroll-max();
                                        page-size: max(1.0, files-flick.height / 1px);
                                        press() => { root.dismiss-any-rename-if-any(); }
                                        scrolled(v) => {
                                            files-flick.viewport-y = -v * 1px;
                                        }
                                    }
                                }

                                // FILTERS — IN/OUT panel. The Terminal tab never has filters; hide the
                                // whole section instead of a dead "applies on other tabs" stub.
                                if root.filters-editable: Rectangle {
                                    height: 1px;
                                    background: Theme.border-subtle;
                                    vertical-stretch: 0;
                                }

                                if root.filters-editable: VerticalLayout {
                                    spacing: 6px;
                                    vertical-stretch: 0;
                                    padding-left: 12px;
                                    padding-right: 12px;

                                    Text {
                                        text: "FILTERS";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-stretch: 0;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        vertical-stretch: 0;

                                        for filt in root.filters-model: FilterRow {
                                            filter-id: filt.id;
                                            filter-type: filt.filter-type;
                                            pattern: filt.pattern;
                                            enabled: filt.enabled;
                                            use-regex: filt.use-regex;
                                            can-edit: !root.is-renaming();
                                            toggled(on) => { root.dismiss-any-rename-if-any(); root.filter-toggle(filt.id, on); }
                                            remove-clicked => { root.dismiss-any-rename-if-any(); root.filter-remove(filt.id); }
                                            pattern-committed(text) => { root.dismiss-any-rename-if-any(); root.filter-update(filt.id, text); }
                                            pattern-editing-changed(text, active) => {
                                                if (active) {
                                                    root.filter-draft-changed(text, filt.use-regex);
                                                } else {
                                                    root.filter-draft-changed(root.filter-draft, root.filter-draft-regex);
                                                }
                                            }
                                            pattern-edit-finished => {
                                                viewport-host.focus();
                                            }
                                        }
                                    }

                                    if root.filters-editable: HorizontalLayout {
                                        spacing: 4px;
                                        vertical-stretch: 0;
                                        height: 28px;

                                        // Square TextInput chrome (not fluent LineEdit) so the left edge
                                        // lines up with Include/Exclude below — no fluent inset.
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 100%;
                                            border-radius: 4px;
                                            background: Theme.bg-input;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                            clip: true;

                                            // Same overlay recipe as Find: fill the chrome, text left-aligned.
                                            if root.filter-draft == "": Text {
                                                x: 8px;
                                                width: parent.width - 12px;
                                                height: 100%;
                                                text: "add pattern…";
                                                color: Theme.text-muted;
                                                font-size: 12px;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }

                                            TextInput {
                                                x: 8px;
                                                width: parent.width - 12px;
                                                height: 100%;
                                                min-width: 1px;
                                                text <=> root.filter-draft;
                                                font-size: 12px;
                                                color: Theme.text-primary;
                                                horizontal-alignment: left;
                                                vertical-alignment: center;
                                                selection-background-color: Theme.selection-bg;
                                                selection-foreground-color: Theme.selection-fg;
                                                single-line: true;
                                                // Disable during tab/terminal rename so this field cannot steal
                                                // focus from the rename TextInput.
                                                enabled: root.filters-editable && !root.is-renaming();
                                                edited => {
                                                    root.filter-draft-changed(self.text, root.filter-draft-regex);
                                                }
                                                // Enter → Include (convenient default).
                                                accepted => {
                                                    if (root.filter-draft != "") {
                                                        root.filter-add("include", root.filter-draft, root.filter-draft-regex);
                                                        root.filter-draft = "";
                                                        root.filter-draft-changed("", root.filter-draft-regex);
                                                    }
                                                }
                                            }
                                        }

                                        ModeToggle {
                                            label: ".*";
                                            tip: "Regex mode";
                                            active <=> root.filter-draft-regex;
                                            chip-width: 26px;
                                            toggled(_) => {
                                                root.dismiss-any-rename-if-any();
                                                root.filter-draft-changed(root.filter-draft, root.filter-draft-regex);
                                            }
                                        }
                                    }

                                    if root.filters-editable: HorizontalLayout {
                                        spacing: 6px;
                                        vertical-stretch: 0;
                                        height: 28px;

                                        TouchArea {
                                            horizontal-stretch: 1;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.dismiss-any-rename-if-any();
                                                if (root.filter-draft != "") {
                                                    root.filter-add("include", root.filter-draft, root.filter-draft-regex);
                                                    root.filter-draft = "";
                                                    root.filter-draft-changed("", root.filter-draft-regex);
                                                }
                                            }

                                            Rectangle {
                                                width: 100%;
                                                height: 100%;
                                                border-radius: 4px;
                                                background: parent.has-hover ? Theme.bg-input-hover : Theme.bg-input;
                                                border-width: 1px;
                                                border-color: Theme.border;

                                                Text {
                                                    width: 100%;
                                                    height: 100%;
                                                    text: "+ Include";
                                                    color: Theme.include;
                                                    font-size: 12px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            horizontal-stretch: 1;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.dismiss-any-rename-if-any();
                                                if (root.filter-draft != "") {
                                                    root.filter-add("exclude", root.filter-draft, root.filter-draft-regex);
                                                    root.filter-draft = "";
                                                    root.filter-draft-changed("", root.filter-draft-regex);
                                                }
                                            }

                                            Rectangle {
                                                width: 100%;
                                                height: 100%;
                                                border-radius: 4px;
                                                background: parent.has-hover ? Theme.bg-input-hover : Theme.bg-input;
                                                border-width: 1px;
                                                border-color: Theme.border;

                                                Text {
                                                    width: 100%;
                                                    height: 100%;
                                                    text: "- Exclude";
                                                    color: Theme.exclude;
                                                    font-size: 12px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if root.filters-editable: TouchArea {
                                        height: 24px;
                                        mouse-cursor: pointer;
                                        vertical-stretch: 0;
                                        clicked => { root.dismiss-any-rename-if-any(); root.filter-clear(); }

                                        Text {
                                            width: 100%;
                                            height: 100%;
                                            text: "Clear all filters";
                                            color: parent.has-hover ? Theme.text-primary : Theme.text-secondary;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Leftover sidebar height (empty FILES, gap under lists). Must
                                // dismiss inline rename — a bare Rectangle ate clicks and left
                                // the editor stuck.
                                sidebar-dead-space := TouchArea {
                                    vertical-stretch: 1;
                                    mouse-cursor: default;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            root.dismiss-any-rename-if-any();
                                        }
                                    }
                                    clicked => {
                                        root.dismiss-any-rename-if-any();
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                    }
                }

                // Main column: tabs + viewport + status
                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;
                    horizontal-stretch: 1;

                    FocusScope {
                        // Height follows children (~36px without H bar, ~46px with). Do not bind
                        // FocusScope.height to tabs-scroll-max() — that layoutinfo-cycles with flick width.
                        // H bar is `if` below tabs so preferred height collapses when unused.
                        // Keep focus on the rename TextInput; strip presses must not blur it.
                        // Click-away (gutter / + / restore) commits via dismiss-any-rename-if-any.
                        focus-on-click: !root.is-renaming();

                        changed has-focus => {
                            if (!self.has-focus) {
                                root.dismiss-any-rename-if-any();
                            }
                        }
                        vertical-stretch: 0;

                        key-pressed(_event) => { reject }

                        Rectangle {
                            background: Theme.bg-bar;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;
                                padding-top: 2px;
                                padding-left: 4px;
                                padding-right: 6px;

                                // [Flickable (full stretch slot) | | + | restore] — buttons outside flick.
                                // Do NOT use alignment: center/start on the outer row: that ignores
                                // horizontal-stretch and collapses the flick.
                                //
                                // Empty gutter double-click → tab-add: overlay TouchArea *on top of* the
                                // flick's empty region (right of chips). Sibling max-width layout
                                // reintroduced binding loops with tabs-strip-slot.width.
                                HorizontalLayout {
                                    spacing: 3px;
                                    height: 34px;

                                    tabs-strip-slot := Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        height: 34px;
                                        clip: true;

                                        tab-flick := Flickable {
                                            width: 100%;
                                            height: 100%;
                                            viewport-height: 34px;
                                            // Chips-only — do not pad viewport to flick width (that would make
                                            // tabs-row fill the slot and zero the overlay gutter).
                                            viewport-width: max(tabs-row.preferred-width, 1px);
                                            viewport-x: -root.tabs-scroll-x * 1px;
                                            // Disable flick drag-scroll only during *tab* rename.
                                            interactive: root.renaming-tab-index < 0;

                                            changed viewport-x => {
                                                root.tabs-scroll-x = clamp(-self.viewport-x / 1px, 0.0, root.tabs-scroll-max());
                                            }
                                            // Window-resize shrink path must re-clamp too.
                                            changed width => {
                                                root.sync-tabs-bar-visible();
                                                root.clamp-tabs-scroll();
                                            }
                                            changed viewport-width => { root.clamp-tabs-scroll(); }

                                            tabs-row := HorizontalLayout {
                                                spacing: 0px;
                                                alignment: start;
                                                height: 34px;

                                                for tab in root.tabs-model: TabChip {
                                                    title: tab.name;
                                                    active: tab.index == root.active-tab-index;
                                                    show-close: !tab.is-terminal-tab && root.tabs-model.length > 1;
                                                    can-rename: !tab.is-terminal-tab;
                                                    tab-index: tab.index;
                                                    can-reorder: !tab.is-terminal-tab;
                                                    dim-as-drag-source: root.tab-dragging && root.tab-drag-from == tab.index;
                                                    renaming: root.renaming-tab-index == tab.index;
                                                    rename-text: root.rename-draft;
                                                    activated => {
                                                        root.dismiss-any-rename-if-any();
                                                        root.tab-switch(tab.index);
                                                    }
                                                    close-clicked => {
                                                        root.dismiss-any-rename-if-any();
                                                        root.tab-close(tab.index);
                                                    }
                                                    wheel(dy) => { root.scroll-tabs-by(dy); }
                                                    rename-requested => {
                                                        root.tab-switch(tab.index);
                                                        root.start-tab-rename(tab.index);
                                                    }
                                                    rename-edited(text) => {
                                                        root.rename-draft = text;
                                                    }
                                                    rename-accepted(text) => {
                                                        root.commit-tab-rename(tab.index, text);
                                                    }
                                                    rename-cancelled => {
                                                        root.end-tab-rename();
                                                    }
                                                    reorder-drag-start(index) => {
                                                        root.tab-dragging = true;
                                                        root.tab-drag-from = index;
                                                        root.tab-drop-to = index;
                                                        root.tab-drop-gap = index;
                                                        root.tab-drag-title = (index >= 0 && index < root.tabs-model.length)
                                                            ? root.tabs-model[index].name
                                                            : "";
                                                    }
                                                    reorder-drag-move(local-x, local-y) => { root.update-tab-drop(local-x, local-y); }
                                                    reorder-drag-end => { root.finish-tab-drag(); }
                                                }
                                            }
                                        }

                                        // Overlay empty gutter (right of chips). Later sibling + high z → on top for hits.
                                        TouchArea {
                                            x: min(tabs-row.preferred-width, tab-flick.width);
                                            width: max(0px, tab-flick.width - min(tabs-row.preferred-width, tab-flick.width));
                                            height: 100%;
                                            z: 20;
                                            mouse-cursor: default;
                                            scroll-event(event) => {
                                                root.scroll-tabs-by(event.delta-y / 1px);
                                                accept
                                            }
                                            // Strip focus-on-click is off while renaming — a gutter press
                                            // would otherwise leave the TextInput focused and stuck.
                                            clicked => {
                                                root.dismiss-any-rename-if-any();
                                            }
                                            pointer-event(event) => {
                                                if (event.kind == PointerEventKind.down) {
                                                    root.dismiss-any-rename-if-any();
                                                }
                                            }
                                            double-clicked => {
                                                root.gutter-request-tab-add();
                                            }
                                        }
                                    }

                                    // Same look as TabChip’s right-edge divider — separates strip from actions.
                                    Rectangle {
                                        width: 1px;
                                        height: 100%;
                                        horizontal-stretch: 0;
                                        background: Theme.border;
                                    }

                                    // Fixed actions — outside Flickable, docked at the right edge.
                                    TouchArea {
                                        width: 28px;
                                        height: 28px;
                                        horizontal-stretch: 0;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.dismiss-any-rename-if-any();
                                            root.tab-add();
                                        }
                                        scroll-event(event) => {
                                            root.scroll-tabs-by(event.delta-y / 1px);
                                            accept
                                        }

                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 0px;
                                            background: parent.has-hover ? Theme.bg-input : transparent;

                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: "+";
                                                color: Theme.text-primary;
                                                font-size: 16px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    TouchArea {
                                        width: 28px;
                                        height: 28px;
                                        horizontal-stretch: 0;
                                        mouse-cursor: pointer;
                                        enabled: root.can-restore-tab;
                                        clicked => {
                                            root.dismiss-any-rename-if-any();
                                            root.tab-restore();
                                        }
                                        scroll-event(event) => {
                                            root.scroll-tabs-by(event.delta-y / 1px);
                                            accept
                                        }

                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 0px;
                                            background: parent.has-hover && root.can-restore-tab ? Theme.bg-input : transparent;
                                            opacity: root.can-restore-tab ? 1.0 : 0.35;

                                            // Path restore arrow — never Unicode ↩.
                                            Path {
                                                x: (parent.width - 12px) / 2;
                                                y: (parent.height - 10px) / 2;
                                                width: 12px;
                                                height: 10px;
                                                stroke: Theme.text-secondary;
                                                stroke-width: 1.25px;
                                                fill: transparent;
                                                viewbox-x: 0;
                                                viewbox-y: 0;
                                                viewbox-width: 12;
                                                viewbox-height: 10;
                                                commands: "M 4 1 L 1 4 L 4 7 M 1 4 H 8 A 3 3 0 0 1 8 9 H 5";
                                            }
                                        }
                                    }
                                }

                                // Below tabs (not overlay). `if` collapses preferred height when unused.
                                // Visibility comes from sync-tabs-bar-visible() — not tabs-scroll-max()
                                // inline — so layoutinfo does not cycle through tab-flick.width.
                                if root.tabs-bar-visible: EngineScrollBar {
                                    height: 10px;
                                    horizontal: true;
                                    horizontal-stretch: 1;
                                    // Two-way so scroll-tabs-by / Flickable keep the thumb in sync.
                                    value <=> root.tabs-scroll-x;
                                    maximum: root.tabs-scroll-max();
                                    page-size: max(1.0, tab-flick.width / 1px);
                                    press() => { root.dismiss-any-rename-if-any(); }
                                    scrolled(v) => {
                                        tab-flick.viewport-x = -v * 1px;
                                    }
                                }
                            }
                        }
                    }

                    viewport-host := FocusScope {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        focus-on-click: true;

                        changed has-focus => {
                            if (self.has-focus) {
                                // Terminal tab/viewport took keyboard focus — close any stuck rename chrome.
                                root.dismiss-any-rename-if-any();
                            }
                            root.viewport-focused(self.has-focus);
                        }

                        key-pressed(event) => {
                            if (root.key-event(
                                event.text,
                                event.modifiers.control,
                                event.modifiers.meta,
                                event.modifiers.alt,
                                event.modifiers.shift,
                            )) {
                                accept
                            } else {
                                reject
                            }
                        }

                        // Clip so the V-scrollbar cannot paint over the status bar below
                        // (layout rounding otherwise leaves a 1px track under the footer).
                        Rectangle {
                            clip: true;
                            vertical-stretch: 1;
                            horizontal-stretch: 1;
                            background: Theme.bg-window;

                            VerticalLayout {
                                spacing: 0px;
                                vertical-stretch: 1;
                                horizontal-stretch: 1;

                                if root.show-launch-preview: TouchArea {
                                    height: 22px;
                                    vertical-stretch: 0;
                                    mouse-cursor: default;
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.down) {
                                            root.dismiss-any-rename-if-any();
                                        }
                                    }
                                    Rectangle {
                                        height: 22px;
                                        width: 100%;
                                        background: Theme.bg-bar;
                                        border-width: 0px;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;

                                            Text {
                                                text: root.launch-preview-text;
                                                color: Theme.text-secondary;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 0px;
                                    vertical-stretch: 1;
                                    horizontal-stretch: 1;

                                    image-cell := Rectangle {
                                        horizontal-stretch: 1;
                                        vertical-stretch: 1;
                                        background: Theme.bg-window;
                                        clip: true;

                                        // Empty Image writes alpha 0 over this fill (transparent
                                        // winit swapchain → terminal/VRAM shows through).
                                        if root.viewport-image.width > 0 && root.viewport-image.height > 0: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: root.viewport-image;
                                            image-fit: fill;
                                        }

                                        // Block caret overlay — blink toggles opacity only (no Image repaint,
                                        // no create/destroy of the Rectangle which can miss the first frames).
                                        Rectangle {
                                            x: root.caret-x * 1px;
                                            y: root.caret-y * 1px;
                                            width: max(1px, root.caret-w * 1px);
                                            height: max(1px, root.caret-h * 1px);
                                            border-radius: 0px;
                                            border-width: 0px;
                                            background: Theme.text-primary;
                                            visible: root.caret-visible;
                                            opacity: root.caret-blink-on ? 1.0 : 0.0;
                                        }

                                        // Custom popup: MenuItem.shortcut is MenuBar-only in Slint 1.17,
                                        // so accelerators use a fluent-like title + muted secondary text row.
                                        viewport-ctx := PopupWindow {
                                            x: root.viewport-menu-x;
                                            y: root.viewport-menu-y;
                                            close-policy: close-on-click;

                                            Rectangle {
                                                background: Theme.bg-panel;
                                                border-radius: 0px;
                                                border-width: 1px;
                                                border-color: Theme.border;
                                                drop-shadow-color: Theme.shadow-menu;
                                                drop-shadow-offset-y: 8px;
                                                drop-shadow-blur: 16px;

                                                VerticalLayout {
                                                    // Menu popup chrome padding (all sides) — tweak here
                                                    // (mirrors ChromeMenuPopup; viewport RMB uses CtxAccelMenuItem)
                                                    padding: 4px;
                                                    min-width: 200px;

                                                    CtxAccelMenuItem {
                                                        title: "Copy";
                                                        accelerator: "Shift+Ctrl+C";
                                                        item-enabled: root.can-copy;
                                                        activated => { root.viewport-copy(); }
                                                    }

                                                    CtxAccelMenuItem {
                                                        title: "Paste";
                                                        accelerator: "Shift+Ctrl+V";
                                                        item-enabled: root.can-paste;
                                                        activated => { root.viewport-paste(); }
                                                    }
                                                }
                                            }
                                        }

                                        TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            // Always I-beam over the log bitmap.
                                            mouse-cursor: text;

                                            clicked => {
                                                root.dismiss-any-rename-if-any();
                                                viewport-host.focus();
                                            }

                                            pointer-event(event) => {
                                                // Only pointer-*down* takes Terminal tab focus / dismisses rename.
                                                // Hover/move over the viewport must NOT steal rename focus.
                                                if (event.kind == PointerEventKind.down) {
                                                    root.dismiss-any-rename-if-any();
                                                    viewport-host.focus();
                                                }
                                                if (event.button == PointerEventButton.right) {
                                                    // Right-click: open menu near cursor; do not start selection.
                                                    if (event.kind == PointerEventKind.down) {
                                                        root.viewport-context-opening();
                                                        root.viewport-menu-x = self.mouse-x;
                                                        root.viewport-menu-y = self.mouse-y;
                                                        viewport-ctx.show();
                                                    }
                                                    return;
                                                }
                                                if (event.button != PointerEventButton.left
                                                    && event.button != PointerEventButton.middle) {
                                                    return;
                                                }
                                                if (event.kind == PointerEventKind.down) {
                                                    root.viewport-pointer(
                                                        self.mouse-x / 1px,
                                                        self.mouse-y / 1px,
                                                        event.button == PointerEventButton.middle ? 1 : 0,
                                                        0,
                                                    );
                                                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                                    root.viewport-pointer(
                                                        self.mouse-x / 1px,
                                                        self.mouse-y / 1px,
                                                        event.button == PointerEventButton.middle ? 1 : 0,
                                                        1,
                                                    );
                                                }
                                            }

                                            moved => {
                                                // `pressed` is left-button only — right-click won't drag-select.
                                                if (self.pressed) {
                                                    root.viewport-pointer(self.mouse-x / 1px, self.mouse-y / 1px, 0, 2);
                                                }
                                            }

                                            scroll-event(event) => {
                                                if (event.modifiers.control || event.modifiers.meta) {
                                                    root.viewport-zoom-wheel(event.delta-y / 1px);
                                                    accept
                                                } else if (abs(event.delta-x) > abs(event.delta-y)) {
                                                    // Prefer horizontal when delta-x dominates (trackpad / shift-wheel).
                                                    root.viewport-scrolled-x(event.delta-x / 1px);
                                                    accept
                                                } else {
                                                    root.viewport-scrolled(event.delta-y / 1px);
                                                    accept
                                                }
                                            }
                                        }

                                        // VS Code–style find bar (after TouchArea so it receives clicks).
                                        find-bar := FindBar {
                                            x: parent.width - self.width - 10px;
                                            y: 8px;
                                            width: min(420px, parent.width - 20px);
                                            find-open <=> root.find-open;
                                            find-query <=> root.find-query;
                                            find-case-sensitive <=> root.find-case-sensitive;
                                            find-whole-word <=> root.find-whole-word;
                                            find-regex <=> root.find-regex;
                                            find-status <=> root.find-status;
                                            find-error <=> root.find-error;
                                            find-focus-request <=> root.find-focus-request;
                                            find-query-changed(q, regex, case-sensitive, whole-word) => {
                                                root.find-query-changed(q, regex, case-sensitive, whole-word);
                                            }
                                            find-goto(direction) => { root.find-goto(direction); }
                                            find-commit => { root.find-commit(); }
                                            find-closed => { root.find-closed(); }
                                            request-viewport-focus => { viewport-host.focus(); }
                                        }

                                        changed width => {
                                            root.viewport-resized(self.width, self.height);
                                        }
                                        changed height => {
                                            root.viewport-resized(self.width, self.height);
                                        }
                                    }

                                    // Always reserve the V-scrollbar track so the viewport width
                                    // does not jump when content first becomes scrollable.
                                    // Fixed width; height comes only from this row (above status).
                                    EngineScrollBar {
                                        horizontal: false;
                                        width: 10px;
                                        vertical-stretch: 1;
                                        clip: true;
                                        value <=> root.scroll-y;
                                        maximum: root.max-scroll-y;
                                        page-size: root.viewport-page-h;
                                        press() => { root.dismiss-any-rename-if-any(); }
                                        scrolled(v) => { root.viewport-scroll-y-changed(v); }
                                        drag-active(active) => { root.viewport-scrollbar-drag-active(active); }
                                    }
                                }

                                if root.show-hscroll && root.max-scroll-x > 0.5: HorizontalLayout {
                                    height: 10px;
                                    vertical-stretch: 0;
                                    spacing: 0px;

                                    EngineScrollBar {
                                        horizontal: true;
                                        height: 10px;
                                        horizontal-stretch: 1;
                                        value <=> root.scroll-x;
                                        maximum: root.max-scroll-x;
                                        page-size: root.viewport-page-w;
                                        press() => { root.dismiss-any-rename-if-any(); }
                                        scrolled(v) => { root.viewport-scroll-x-changed(v); }
                                    }

                                    // Corner filler matching the always-on V-scrollbar width.
                                    Rectangle {
                                        width: 10px;
                                        background: Theme.bg-input;
                                    }
                                }

                                // Status lives in the same clipped column as the V-scrollbar so the
                                // track cannot paint into/under the footer (layout overflow).
                                StatusBar {
                                    status-text: root.status-text;
                                    matches-capped: root.matches-capped;
                                    line-position-text: root.line-position-text;
                                    pressed-down => { root.dismiss-any-rename-if-any(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Paint-only tab-drag ghost (no TouchArea — must not steal the reorder pointer).
        // Sibling of the CSD VerticalLayout so tabs-strip-slot clip cannot hide it.
        // Explicit width: default is 100% of the window, which painted a full-span bar.
        if root.tab-dragging: Rectangle {
            x: root.tab-drag-preview-x - csd-frame.absolute-position.x + 8px;
            y: root.tab-drag-preview-y - csd-frame.absolute-position.y + 10px;
            width: min(160px, max(88px, ghost-title.preferred-width + 32px));
            height: 26px;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            opacity: 0.85;
            background: Theme.bg-input;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 0px;
            z: 50;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                ghost-title := Text {
                    text: root.tab-drag-title;
                    color: Theme.text-primary;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                }

                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    Path {
                        width: 10px;
                        height: 10px;
                        stroke: Theme.text-muted;
                        stroke-width: 1.25px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 10;
                        viewbox-height: 10;
                        commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
                    }
                }
            }
        }

        if root.tab-drop-line-visible: Rectangle {
            x: root.tab-drop-line-x - csd-frame.absolute-position.x;
            y: root.tab-drop-line-y - csd-frame.absolute-position.y;
            width: 2px;
            height: 34px;
            horizontal-stretch: 0;
            vertical-stretch: 0;
            background: Theme.text-muted;
            z: 51;
        }
    }

    // File → Projects overlay (list / create / rename in one popup).
    projects-dlg := PopupWindow {
        x: (parent.width - Theme.overlay-width) / 2;
        y: max(Theme.overlay-margin-top, (parent.height - self.height) / 2);
        width: Theme.overlay-width;
        close-policy: close-on-click-outside;

        projects-panel := ProjectsDialog {
            width: 100%;
            projects: root.projects-model;
            dialog-mode <=> root.projects-dialog-mode;
            name-draft <=> root.projects-name-draft;
            rename-id <=> root.projects-rename-id;
            closed => { root.close-projects(); }
            project-open(id) => {
                root.project-open(id);
                root.close-projects();
            }
            project-create(name) => { root.project-create(name); }
            project-rename(id, name) => { root.project-rename(id, name); }
            project-delete(id) => { root.project-delete(id); }
        }
    }

    edit-launch-dlg := PopupWindow {
        x: (parent.width - Theme.overlay-width) / 2;
        y: max(Theme.overlay-margin-top, (parent.height - self.height) / 2);
        width: Theme.overlay-width;
        close-policy: close-on-click-outside;

        edit-launch-panel := EditLaunchDialog {
            host-is-windows: root.host-is-windows;
            command-draft <=> root.launch-command-draft;
            args-draft <=> root.launch-args-draft;
            cwd-draft <=> root.launch-cwd-draft;
            wsl-draft <=> root.launch-wsl-draft;
            wsl-distro-draft <=> root.launch-wsl-distro-draft;
            cancelled => { edit-launch-dlg.close(); }
            confirmed => { root.confirm-edit-launch(); }
        }
    }

    // Settings dialog — max scrollback lines.
    settings-dlg := PopupWindow {
        x: (parent.width - Theme.overlay-width) / 2;
        y: max(Theme.overlay-margin-top, (parent.height - self.height) / 2);
        width: Theme.overlay-width;
        close-policy: close-on-click-outside;

        settings-panel := SettingsDialog {
            settings-draft <=> root.settings-draft;
            cancelled => { root.close-settings(); }
            confirmed => { root.confirm-settings(); }
        }
    }

    // About dialog — product info + Slint Royalty-free attribution.
    // PopupWindow is lowered into its own component, so `root.width` here is the
    // popup (x ≈ 16px, stuck left). `parent` is AppWindow — center on that.
    about-dlg := PopupWindow {
        x: (parent.width - Theme.overlay-width) / 2;
        y: max(Theme.overlay-margin-top, (parent.height - self.height) / 2);
        width: Theme.overlay-width;
        close-policy: close-on-click-outside;

        about-panel := AboutDialog {
            cancelled => { root.close-about(); }
            confirmed => { root.close-about(); }
            open-slint-site => {
                root.open-url("https://slint.dev");
                root.close-about();
            }
        }
    }

    quit-dlg := PopupWindow {
        x: (parent.width - Theme.overlay-width) / 2;
        y: max(Theme.overlay-margin-top, (parent.height - self.height) / 2);
        width: Theme.overlay-width;
        close-policy: close-on-click-outside;

        quit-panel := QuitConfirmDialog {
            cancelled => { root.close-quit-confirm(); }
            confirmed => { root.confirm-quit(); }
        }
    }
}
