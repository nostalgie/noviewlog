// File → Projects overlay: list / create / rename in one PopupWindow
// (nested popups would dismiss the list on click-outside).
// Square Theme borders only — never Theme.accent / fluent LineEdit focus bars.
// Icons are Path (TerminalRowIcon); actions are AppButton — never Unicode ✎/×
// or fluent std-widgets Button (Windows UI fonts tofu those glyphs).

import { Theme } from "theme.slint";
import { ProjectInfo } from "types.slint";
import { AppButton, FormTextField, DialogFrame, DialogTitle, DialogFooter } from "form-dialogs.slint";
import { TerminalRowIcon } from "sidebar.slint";

// Frame, title, footer row and padding/spacing/min-width reuse the FormDialogPanel
// recipe (DialogFrame / DialogTitle / DialogFooter / Theme.dialog-*); the body here
// is mode-dependent, so the panel itself cannot host it.
export component ProjectsDialog inherits DialogFrame {
    in property <[ProjectInfo]> projects;
    callback closed();
    callback project-open(id: string);
    callback project-create(name: string);
    callback project-rename(id: string, name: string);
    callback project-delete(id: string);

    in-out property <string> dialog-mode: "list";
    in-out property <string> name-draft: "";
    in-out property <string> rename-id: "";
    // Issue #82: delete needs an explicit confirm step before the engine call.
    in-out property <string> delete-id: "";

    init => {
        // Issue #107: focus the dialog key scope when the popup is shown so
        // Escape works immediately and keys cannot leak to the viewport.
        dialog-keys.focus();
    }

    function reset-to-list() {
        root.dialog-mode = "list";
        root.name-draft = "";
        root.rename-id = "";
        root.delete-id = "";
    }

    function begin-delete(id: string, name: string) {
        root.delete-id = id;
        root.name-draft = name;
        root.dialog-mode = "confirm-delete";
    }

    function begin-create() {
        root.name-draft = "";
        root.rename-id = "";
        root.dialog-mode = "create";
    }

    function begin-rename(id: string, name: string) {
        root.rename-id = id;
        root.name-draft = name;
        root.dialog-mode = "rename";
    }

    function cancel-form() {
        root.reset-to-list();
    }

    function confirm-form() {
        if (root.name-draft == "") {
            return;
        }
        if (root.dialog-mode == "create") {
            root.project-create(root.name-draft);
        } else if (root.dialog-mode == "rename") {
            root.project-rename(root.rename-id, root.name-draft);
        } else if (root.dialog-mode == "confirm-delete") {
            root.project-delete(root.delete-id);
        }
        root.reset-to-list();
    }

    property <string> panel-title: root.dialog-mode == "create" ? "Create project" : (root.dialog-mode == "rename" ? "Rename project" : (root.dialog-mode == "confirm-delete" ? "Delete project" : "Projects"));

    dialog-keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            // Enter confirms in confirm-delete (no text field); create/rename use
            // FormTextField.accepted. Matches FormDialogPanel (#333).
            if (event.text == Key.Return || event.text == "\n") {
                if (root.dialog-mode == "confirm-delete") {
                    root.confirm-form();
                    accept
                } else {
                    reject
                }
            } else if (event.text == Key.Escape) {
                if (root.dialog-mode == "list") {
                    root.closed();
                } else {
                    root.cancel-form();
                }
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            padding: Theme.dialog-pad;
            spacing: Theme.dialog-spacing;
            min-width: Theme.dialog-min-width;

            HorizontalLayout {
                spacing: 8px;
                alignment: stretch;

                DialogTitle {
                    text: root.panel-title;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if root.dialog-mode == "list": AppButton {
                    text: "New";
                    clicked => { root.begin-create(); }
                }
            }

            if root.dialog-mode == "list": VerticalLayout {
                spacing: 8px;
                width: 100%;

                Flickable {
                    height: 220px;
                    viewport-width: parent.width;
                    width: 100%;

                    VerticalLayout {
                        width: 100%;
                        spacing: 3px;

                        if root.projects.length == 0: HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 8px;
                            Text {
                                text: "No projects — New to create one";
                                color: Theme.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }

                        for proj in root.projects: TouchArea {
                            height: 32px;
                            mouse-cursor: pointer;
                            clicked => {
                                root.project-open(proj.id);
                            }

                            // Selection = full-width fill only — never Theme.accent border.
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                border-radius: 0px;
                                border-width: 0px;
                                background: proj.active ? Theme.accent-soft : (parent.has-hover ? Theme.bg-input : transparent);
                            }

                            HorizontalLayout {
                                width: 100%;
                                height: 100%;
                                padding-left: 10px;
                                padding-right: 4px;
                                spacing: 4px;
                                alignment: stretch;

                                Text {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: proj.name;
                                    color: proj.active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: 12px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 0;
                                    vertical-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: proj.program-count;
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                TerminalRowIcon {
                                    kind: "edit";
                                    width: 22px;
                                    height: 22px;
                                    clicked => {
                                        root.begin-rename(proj.id, proj.name);
                                    }
                                }

                                TerminalRowIcon {
                                    kind: "close";
                                    width: 22px;
                                    height: 22px;
                                    clicked => {
                                        root.begin-delete(proj.id, proj.name);
                                    }
                                }
                            }
                        }
                    }
                }

                DialogFooter {
                    AppButton {
                        text: "Close";
                        primary: true;
                        clicked => { root.closed(); }
                    }
                }
            }

            if root.dialog-mode != "list": VerticalLayout {
                spacing: Theme.dialog-spacing;
                width: 100%;

                if root.dialog-mode == "confirm-delete": Text {
                    text: "Delete project \"" + root.name-draft + "\" with all its programs and workspaces? This cannot be undone.";
                    color: Theme.text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                if root.dialog-mode != "confirm-delete": FormTextField {
                    label: "Name";
                    text <=> root.name-draft;
                    focus-on-init: true;
                    accepted => { root.confirm-form(); }
                    cancelled => { root.cancel-form(); }
                }

                DialogFooter {
                    AppButton {
                        text: "Cancel";
                        clicked => { root.cancel-form(); }
                    }
                    AppButton {
                        text: root.dialog-mode == "create" ? "Create" : (root.dialog-mode == "confirm-delete" ? "Delete" : "OK");
                        primary: true;
                        clicked => { root.confirm-form(); }
                    }
                }
            }
        }
    }
}
