// Sidebar / tab-strip building blocks (terminals list, filters, tabs, scrollbars).

import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { CtxAccelMenuItem } from "chrome-menus.slint";

// Root is TouchArea so wheel works over chip padding and the 1px divider
// (child Rectangles do not steal pointer events).
export component TabChip inherits TouchArea {
    in property <string> title;
    in property <bool> active;
    in property <bool> show-close;
    // False for the Terminal tab — double-click / context Rename must not start rename.
    in property <bool> can-rename: true;
    in property <bool> renaming: false;
    in property <string> rename-text: "";
    in property <int> tab-index: 0;
    in property <bool> can-reorder: true;
    in property <bool> show-drop-before: false;
    in property <bool> show-drop-after: false;
    in property <bool> dim-as-drag-source: false;
    callback close-clicked();
    // Forward wheel so the tab strip can scroll horizontally (Flickable ignores Y-wheel).
    callback wheel(delta-y: float);
    callback rename-requested();
    callback rename-edited(text: string);
    callback rename-accepted(text: string);
    callback rename-cancelled();
    // local-x / local-y are the pointer in tabs-row content space (chip.x + mouse).
    callback reorder-drag-start(index: int);
    callback reorder-drag-move(local-x: length, local-y: length);
    callback reorder-drag-end();

    height: 34px;
    preferred-width: 120px;
    min-width: 120px;
    max-width: 150px;
    // TouchArea defaults to stretch:1 — keep chips at preferred so the empty
    // gutter overlay stays to the right of real chip bounds.
    horizontal-stretch: 0;
    mouse-cursor: root.reorder-dragging ? grabbing : pointer;
    opacity: root.dim-as-drag-source ? 0.45 : 1.0;

    property <length> ctx-menu-x: 0px;
    property <length> ctx-menu-y: 0px;
    property <bool> rename-closing: false;
    // Ignore blur until TextInput has focused once (init focus can race has-focus).
    property <bool> rename-had-focus: false;
    property <bool> press-tracking: false;
    property <float> press-x: 0;
    property <float> press-y: 0;
    property <bool> reorder-dragging: false;
    // double_clicked runs before pointer Up — skip activated on that Up.
    property <bool> skip-next-activated: false;

    scroll-event(event) => {
        root.wheel(event.delta-y / 1px);
        accept
    }

    double-clicked => {
        if (!root.renaming && root.can-rename && !root.reorder-dragging) {
            root.skip-next-activated = true;
            root.rename-requested();
        }
    }

    // Swallow TouchArea clicked when a reorder drag happened (parent uses activated).
    clicked => { }

    callback activated();

    // Double-click: down sets press-tracking, then renaming=true before up.
    // Swallowing all events while renaming left press-tracking stuck → ghost
    // reorder-drag (dim-as-drag-source) after commit. Clear on enter + on up.
    // Also clear skip-next-activated: the double-click Up is handled while
    // renaming, so the flag must not survive and eat the next real click.
    changed renaming => {
        if (root.renaming) {
            if (root.reorder-dragging) {
                root.reorder-drag-end();
            }
            root.press-tracking = false;
            root.reorder-dragging = false;
            root.skip-next-activated = false;
        }
    }

    pointer-event(event) => {
        if (root.renaming) {
            // Clicks on chip chrome outside the TextInput reach the TouchArea — commit.
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.finish-rename-accept(root.rename-text);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (root.reorder-dragging) {
                    root.reorder-drag-end();
                }
                root.press-tracking = false;
                root.reorder-dragging = false;
                root.skip-next-activated = false;
            }
            return;
        }
        if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.down) {
            root.close-clicked();
            return;
        }
        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
            root.ctx-menu-x = self.mouse-x;
            root.ctx-menu-y = self.mouse-y;
            chip-ctx.show();
            return;
        }
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
            root.press-tracking = true;
            root.press-x = self.mouse-x / 1px;
            root.press-y = self.mouse-y / 1px;
            root.reorder-dragging = false;
            return;
        }
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
            if (root.reorder-dragging) {
                root.reorder-drag-end();
            } else if (root.press-tracking) {
                if (root.skip-next-activated) {
                    root.skip-next-activated = false;
                } else {
                    root.activated();
                }
            }
            root.press-tracking = false;
            root.reorder-dragging = false;
            return;
        }
        if (event.kind == PointerEventKind.move && root.press-tracking) {
            let dx = self.mouse-x / 1px - root.press-x;
            let dy = self.mouse-y / 1px - root.press-y;
            if (!root.reorder-dragging && root.can-reorder && (dx * dx + dy * dy) > 25) {
                root.reorder-dragging = true;
                root.reorder-drag-start(root.tab-index);
            }
            if (root.reorder-dragging) {
                // Parent-layout coords, not absolute-position: Flickable+row map_to_window
                // double-counts chip.x, so the ghost ran further right with every extra tab.
                root.reorder-drag-move(self.x + self.mouse-x, self.y + self.mouse-y);
            }
        }
    }

    function finish-rename-accept(text: string) {
        if (root.rename-closing || !root.renaming) {
            return;
        }
        root.rename-closing = true;
        root.rename-accepted(text);
    }

    function finish-rename-cancel() {
        if (root.rename-closing || !root.renaming) {
            return;
        }
        root.rename-closing = true;
        root.rename-cancelled();
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 0px;
        background: root.active ? Theme.bg-window : transparent;
    }

    // Reorder drop cue — muted, never Theme.accent (no bright blue on tab strip).
    // Hidden when drop target == source (no-op) so a stuck drag session cannot leave a stripe.
    if root.show-drop-before: Rectangle {
        x: 0px;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: Theme.text-muted;
        z: 10;
    }

    if root.show-drop-after: Rectangle {
        x: parent.width - 2px;
        y: 0px;
        width: 2px;
        height: parent.height;
        background: Theme.text-muted;
        z: 10;
    }

    // Same TextInput chrome recipe as TerminalRow: explicit width:100%, no absolute sizing.
    // Match idle title: text centered in the chip (horizontal-alignment), field vertically centered.
    if root.renaming: VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 0px;
        padding-bottom: 0px;
        alignment: center;

        Rectangle {
            width: 100%;
            height: Theme.rename-tab-height;
            vertical-stretch: 0;
            border-radius: Theme.rename-radius;
            // Square muted outline — never Theme.accent / fluent focus chrome.
            border-width: Theme.rename-border-width;
            border-color: Theme.rename-border;
            background: Theme.rename-bg;
            clip: true;

        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: Theme.field-pad-x;
            padding-right: Theme.field-pad-x;
            padding-top: Theme.field-pad-y;
            padding-bottom: Theme.field-pad-y;
            alignment: stretch;

                rename-edit := TextInput {
                    width: 100%;
                    height: 100%;
                    min-width: 1px;
                    font-size: 12px;
                    color: Theme.rename-text;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    selection-background-color: Theme.selection-bg;
                    selection-foreground-color: Theme.selection-fg;
                    single-line: true;
                    // Keep draft in sync so a stats/layout rebuild of the chip does not
                    // re-init from a stale rename-text and wipe in-progress edits.
                    edited => {
                        root.rename-edited(self.text);
                    }

                    init => {
                        root.rename-closing = false;
                        root.rename-had-focus = false;
                        self.text = root.rename-text;
                        self.focus();
                        self.select-all();
                    }

                    accepted => {
                        root.finish-rename-accept(self.text);
                    }

                    // Real focus loss commits. Mouse leave must not blur (gated FocusScopes).
                    changed has-focus => {
                        if (self.has-focus) {
                            root.rename-had-focus = true;
                        } else if (root.rename-had-focus && root.renaming && !root.rename-closing) {
                            root.finish-rename-accept(self.text);
                        }
                    }

                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.finish-rename-cancel();
                            accept
                        } else {
                            reject
                        }
                    }
                }
            }
        }
    }

    if !root.renaming: HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding-left: 6px;
        padding-right: 6px;
        // Stretch so side columns fill chip height; VerticalLayout centers the close control.
        alignment: stretch;

        // Mirror the close control width so the title stays optically centered.
        if root.show-close: VerticalLayout {
            width: 18px;
            alignment: center;

            Rectangle {
                width: 18px;
                height: 18px;
                background: transparent;
            }
        }

        Text {
            text: root.title;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: 12px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.show-close: VerticalLayout {
            width: 18px;
            alignment: center;

            // Path close — never Unicode × (Windows UI fonts tofu it).
            // Inline Path: TerminalRowIcon is defined later in this file.
            TouchArea {
                width: 18px;
                height: 18px;
                vertical-stretch: 0;
                mouse-cursor: pointer;
                clicked => { root.close-clicked(); }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.middle && event.kind == PointerEventKind.down) {
                        root.close-clicked();
                    }
                }
                scroll-event(event) => {
                    root.wheel(event.delta-y / 1px);
                    accept
                }

                Path {
                    x: (parent.width - 10px) / 2;
                    y: (parent.height - 10px) / 2;
                    width: 10px;
                    height: 10px;
                    stroke: parent.has-hover ? Theme.text-primary : Theme.text-muted;
                    stroke-width: 1.25px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
                }
            }
        }
    }

    // Visual only — parent TouchArea still receives wheel over this strip.
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    chip-ctx := PopupWindow {
        x: root.ctx-menu-x;
        y: root.ctx-menu-y;
        close-policy: close-on-click;

        Rectangle {
            background: Theme.bg-panel;
            border-radius: 0px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-color: Theme.shadow-menu;
            drop-shadow-offset-y: 8px;
            drop-shadow-blur: 16px;

            VerticalLayout {
                padding: 4px;
                min-width: 140px;

                CtxAccelMenuItem {
                    title: "Rename";
                    accelerator: "";
                    item-enabled: root.can-rename;
                    activated => {
                        chip-ctx.close();
                        if (root.can-rename) {
                            root.rename-requested();
                        }
                    }
                }

                CtxAccelMenuItem {
                    title: "Close";
                    accelerator: "";
                    item-enabled: root.show-close;
                    activated => {
                        chip-ctx.close();
                        root.close-clicked();
                    }
                }
            }
        }
    }
}

// One IN/OUT filter row: toggle + badge + editable pattern + remove.
export component FilterRow inherits Rectangle {
    in property <string> filter-id;
    in property <string> filter-type;
    in property <string> pattern;
    in property <bool> enabled;
    in property <bool> use-regex: false;
    in property <bool> can-edit: true;
    callback toggled(enabled: bool);
    callback remove-clicked();
    callback pattern-committed(pattern: string);
    // Live viewport highlight while this row's pattern field is focused.
    // `active` false → parent restores the add-pattern draft preview.
    callback pattern-editing-changed(pattern: string, active: bool);
    // Confirm button / Enter — parent focuses the viewport so the field blurs.
    callback pattern-edit-finished();

    height: 28px;
    border-radius: 4px;
    background: transparent;

    property <bool> is-include: root.filter-type == "include";
    // Ignore blur until TextInput has focused once (init focus can race has-focus).
    property <bool> pattern-had-focus: false;

    changed pattern => {
        if (!pattern-edit.has-focus) {
            pattern-edit.text = root.pattern;
        }
    }

    function commit-pattern-if-any() {
        if (pattern-edit.text == "") {
            pattern-edit.text = root.pattern;
            if (pattern-edit.has-focus) {
                root.pattern-editing-changed(root.pattern, true);
            }
            return;
        }
        if (pattern-edit.text == root.pattern) {
            return;
        }
        root.pattern-committed(pattern-edit.text);
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 6px;
        // stretch (not center): HorizontalLayout.alignment is the horizontal axis.
        alignment: stretch;

        // Checkbox (custom — avoid fluent CheckBox chrome clash).
        // Full-height cell so the 14px box sits on the same baseline as badge/pattern.
        TouchArea {
            width: 18px;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.toggled(!root.enabled); }

            Rectangle {
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 3px;
                border-width: 1px;
                // Fill may use accent; border must not (no blue outline).
                border-color: Theme.border;
                background: root.enabled ? Theme.accent : Theme.bg-input;

                if root.enabled: Path {
                    width: 100%;
                    height: 100%;
                    stroke: Theme.text-primary;
                    stroke-width: 1.25px;
                    fill: transparent;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 1.5 5 L 4 7.5 L 8.5 2.5";
                }
            }
        }

        // IN / OUT badge — 18px chip centered in the 28px row.
        Rectangle {
            width: 28px;
            height: 100%;
            background: transparent;

            Rectangle {
                width: 100%;
                height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.is-include ? Theme.include : Theme.exclude;
                background: root.is-include ? Theme.include-fill : Theme.exclude-fill;

                Text {
                    width: 100%;
                    height: 100%;
                    text: root.is-include ? "IN" : "OUT";
                    color: root.is-include ? Theme.include : Theme.exclude;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Square TextInput (not fluent LineEdit). Idle: no chrome. Focus: Theme.border.
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            height: 100%;
            border-radius: 4px;
            border-width: pattern-edit.has-focus ? 1px : 0px;
            border-color: Theme.border;
            background: pattern-edit.has-focus ? Theme.bg-input : transparent;
            clip: true;

            pattern-edit := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: 100%;
                min-width: 1px;
                font-size: 12px;
                color: Theme.text-primary;
                horizontal-alignment: left;
                vertical-alignment: center;
                selection-background-color: Theme.selection-bg;
                selection-foreground-color: Theme.selection-fg;
                single-line: true;
                enabled: root.can-edit;
                opacity: root.enabled ? 1.0 : 0.55;

                init => {
                    root.pattern-had-focus = false;
                    self.text = root.pattern;
                }

                edited => {
                    root.pattern-editing-changed(self.text, true);
                }

                accepted => {
                    root.commit-pattern-if-any();
                    root.pattern-edit-finished();
                }

                changed has-focus => {
                    if (self.has-focus) {
                        root.pattern-had-focus = true;
                        root.pattern-editing-changed(self.text, true);
                    } else if (root.pattern-had-focus) {
                        root.pattern-had-focus = false;
                        root.commit-pattern-if-any();
                        root.pattern-editing-changed("", false);
                    }
                }

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        self.text = root.pattern;
                        root.pattern-editing-changed(self.text, true);
                        accept
                    } else {
                        reject
                    }
                }
            }
        }

        if root.use-regex: Text {
            text: ".*";
            color: Theme.text-muted;
            font-size: 11px;
            font-weight: 700;
            height: 100%;
            vertical-alignment: center;
            vertical-stretch: 0;
            opacity: root.enabled ? 1.0 : 0.55;
        }

        // Confirm edit — Path check (never Unicode ✓). Hover uses include green.
        TouchArea {
            width: 18px;
            height: 100%;
            mouse-cursor: pointer;
            clicked => {
                root.commit-pattern-if-any();
                root.pattern-edit-finished();
            }

            Path {
                x: (parent.width - 10px) / 2;
                y: (parent.height - 10px) / 2;
                width: 10px;
                height: 10px;
                stroke: parent.has-hover ? Theme.include : Theme.text-muted;
                stroke-width: 1.25px;
                fill: transparent;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M 1.5 5 L 4 7.5 L 8.5 2.5";
            }
        }

        TouchArea {
            width: 18px;
            height: 100%;
            mouse-cursor: pointer;
            clicked => { root.remove-clicked(); }

            Path {
                x: (parent.width - 10px) / 2;
                y: (parent.height - 10px) / 2;
                width: 10px;
                height: 10px;
                stroke: parent.has-hover ? Theme.text-primary : Theme.text-muted;
                stroke-width: 1.25px;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
            }
        }
    }
}

// TERMINALS/FILES section marker — filled disc (never Unicode ● / ▾/▸).
// Collapse still toggles via the header TouchArea; color identifies the section.
export component SectionDot inherits Rectangle {
    in property <color> fill-color: Theme.text-muted;
    /// Dim slightly when the section is collapsed.
    in property <bool> expanded: true;

    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.fill-color;
    opacity: root.expanded ? 1.0 : 0.45;
    horizontal-stretch: 0;
    vertical-stretch: 0;
}

// Root is TouchArea (like TabChip) so double-clicked can start rename without
// destroying the gesture target mid-Released (a child `if !renaming: TouchArea`
// was torn down inside double-clicked and the rename UI never stuck).
// Path icon in a fixed 22×22 hit target — avoids Unicode glyph misalignment (✎/▶/×).
export component TerminalRowIcon inherits TouchArea {
    // "edit" | "play" | "stop" | "close" | "check" | "refresh"
    in property <string> kind;
    in property <float> icon-opacity: 1.0;
    callback wheel(delta-y: float);

    width: 22px;
    height: 22px;
    vertical-stretch: 0;
    mouse-cursor: pointer;
    opacity: root.icon-opacity;

    property <color> icon-color: self.has-hover ? Theme.text-primary : Theme.text-muted;

    scroll-event(event) => {
        root.wheel(event.delta-y / 1px);
        accept
    }

    // 10×10 viewbox, optically centered in the 22×22 hit target.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        background: transparent;

        if root.kind == "edit": Path {
            width: 100%;
            height: 100%;
            stroke: root.icon-color;
            stroke-width: 1px;
            fill: transparent;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 7.5 1.5 L 9.5 3.5 L 3.5 9.5 L 1.5 9.5 L 1.5 7.5 Z";
        }

        if root.kind == "play": Path {
            width: 100%;
            height: 100%;
            fill: root.icon-color;
            stroke-width: 0px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 1 0.5 L 1 9.5 L 9.5 5 Z";
        }

        if root.kind == "stop": Path {
            width: 100%;
            height: 100%;
            fill: root.icon-color;
            stroke-width: 0px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 1.5 1.5 H 8.5 V 8.5 H 1.5 Z";
        }

        if root.kind == "close": Path {
            width: 100%;
            height: 100%;
            stroke: root.icon-color;
            stroke-width: 1.25px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
        }

        if root.kind == "check": Path {
            width: 100%;
            height: 100%;
            stroke: root.icon-color;
            stroke-width: 1.25px;
            fill: transparent;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 1.5 5 L 4 7.5 L 8.5 2.5";
        }

        if root.kind == "refresh": Path {
            width: 100%;
            height: 100%;
            stroke: root.icon-color;
            stroke-width: 1.25px;
            fill: transparent;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 8.5 1.5 A 4 4 0 1 1 1.5 3 M 8.5 1.5 L 6.2 0.2 M 8.5 1.5 L 9.3 3.8";
        }
    }
}

export component TerminalRow inherits TouchArea {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> running;
    in property <bool> active;
    in property <bool> show-close;
    // Pencil: Edit Launch (live terminals). FILES: false.
    in property <bool> show-edit-launch: false;
    // Play/Stop only when a Program has a saved command. Shell-only rows: false.
    in property <bool> show-run-stop: false;
    in property <bool> show-refresh: false;
    in property <string> term-id: "";
    in property <int> term-index: 0;
    in property <bool> show-drop-before: false;
    in property <bool> dim-as-drag-source: false;
    in property <bool> renaming: false;
    in property <string> rename-text: "";
    // False for FILES rows — inline rename is TERMINALS-only.
    in property <bool> can-rename: true;
    // Row status disc — terminals use accent/muted; files use a distinct section color.
    in property <color> status-dot-color: Theme.text-muted;
    // Parent wires activated (not TouchArea.clicked) so drag can suppress select.
    callback activated();
    callback close-clicked();
    callback run-clicked();
    callback stop-clicked();
    callback refresh-clicked();
    callback edit-launch-clicked();
    // Forward wheel so list scroll + docked bar stay in sync.
    callback wheel(delta-y: float);
    callback rename-requested();
    callback rename-edited(text: string);
    callback rename-accepted(text: string);
    callback rename-cancelled();
    callback reorder-drag-start(id: string, from-index: int);
    callback reorder-drag-move(abs-y: length);
    callback reorder-drag-end();

    height: 44px;
    mouse-cursor: pointer;
    opacity: root.dim-as-drag-source ? 0.45 : 1.0;

    property <bool> press-tracking: false;
    property <float> press-x: 0;
    property <float> press-y: 0;
    property <bool> reorder-dragging: false;
    property <bool> rename-closing: false;
    // Ignore blur until TextInput has focused once (init focus can race has-focus).
    property <bool> rename-had-focus: false;
    // double_clicked runs before pointer Up — skip activated on that Up.
    property <bool> skip-next-activated: false;

    function finish-rename-accept(text: string) {
        if (root.rename-closing || !root.renaming) {
            return;
        }
        root.rename-closing = true;
        root.rename-accepted(text);
    }

    function finish-rename-cancel() {
        if (root.rename-closing || !root.renaming) {
            return;
        }
        root.rename-closing = true;
        root.rename-cancelled();
    }

    scroll-event(event) => {
        root.wheel(event.delta-y / 1px);
        accept
    }

    double-clicked => {
        if (!root.renaming && root.can-rename && !root.reorder-dragging) {
            root.skip-next-activated = true;
            root.rename-requested();
        }
    }

    // Swallow built-in clicked — select goes through activated on pointer-up.
    clicked => { }

    // Same as TabChip: clear stuck press-tracking / skip-next-activated so a
    // post-commit click activates on the first try (not the second).
    changed renaming => {
        if (root.renaming) {
            if (root.reorder-dragging) {
                root.reorder-drag-end();
            }
            root.press-tracking = false;
            root.reorder-dragging = false;
            root.skip-next-activated = false;
        }
    }

    pointer-event(event) => {
        if (root.renaming) {
            // Subtitle / padding clicks while renaming reach the row TouchArea — commit.
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.finish-rename-accept(root.rename-text);
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                if (root.reorder-dragging) {
                    root.reorder-drag-end();
                }
                root.press-tracking = false;
                root.reorder-dragging = false;
                root.skip-next-activated = false;
            }
            return;
        }
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
            root.press-tracking = true;
            root.press-x = self.mouse-x / 1px;
            root.press-y = self.mouse-y / 1px;
            root.reorder-dragging = false;
            return;
        }
        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
            if (root.reorder-dragging) {
                root.reorder-drag-end();
            } else if (root.press-tracking) {
                if (root.skip-next-activated) {
                    root.skip-next-activated = false;
                } else {
                    root.activated();
                }
            }
            root.press-tracking = false;
            root.reorder-dragging = false;
            return;
        }
        if (event.kind == PointerEventKind.move && root.press-tracking) {
            let dx = self.mouse-x / 1px - root.press-x;
            let dy = self.mouse-y / 1px - root.press-y;
            if (!root.reorder-dragging && (dx * dx + dy * dy) > 25) {
                root.reorder-dragging = true;
                root.reorder-drag-start(root.term-id, root.term-index);
            }
            if (root.reorder-dragging) {
                root.reorder-drag-move(self.absolute-position.y + self.mouse-y);
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 0px;
        background: root.active ? Theme.accent-soft : transparent;
        // Selection = fill only — no Theme.accent border.
        border-width: 0px;
    }

    // Reorder drop cue — muted only, never Theme.accent.
    if root.show-drop-before: Rectangle {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: 2px;
        background: Theme.border;
        z: 10;
    }

    // One row skeleton: [●][title-slot][actions][×]. Title-slot ALWAYS exists with
    // stretch — conditional children live inside it (never swap the stretch item itself).
    HorizontalLayout {
        width: 100%;
        height: 100%;
        // Indent past section chevron so ● sits under "TERMINALS"/"FILES" text,
        // not under ▾/▸ (header: 8px pad + 20px chevron + 4px gap ≈ 32px).
        padding-left: 32px;
        // 6px content + 10px reserved for overlaid V-scrollbar slot.
        padding-right: 16px;
        spacing: 8px;
        alignment: stretch;

        // Fixed-size status disc (never Unicode ● — tofu on Noto Sans).
        VerticalLayout {
            width: 12px;
            horizontal-stretch: 0;
            vertical-stretch: 1;
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.status-dot-color;
                horizontal-stretch: 0;
                vertical-stretch: 0;
            }
        }

            title-slot := Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            vertical-stretch: 1;
            background: transparent;
            clip: true;

            // One stack always: title-line (fixed height) + subtitle.
            // Swapping two VerticalLayouts + a taller bordered field made the path jump.
            VerticalLayout {
                width: 100%;
                height: 100%;
                spacing: 1px;
                alignment: center;

                title-line := Rectangle {
                    width: 100%;
                    height: Theme.rename-terminal-height;
                    border-radius: Theme.rename-radius;
                    border-width: Theme.rename-border-width;
                    border-color: root.renaming ? Theme.rename-border : transparent;
                    background: root.renaming ? Theme.rename-bg : transparent;
                    clip: true;

                    if !root.renaming: Text {
                        x: Theme.rename-pad;
                        y: Theme.rename-pad;
                        width: parent.width - 2 * Theme.rename-pad;
                        height: parent.height - 2 * Theme.rename-pad;
                        text: root.title;
                        color: root.active ? Theme.text-primary : Theme.text-secondary;
                        font-size: 12px;
                        font-weight: 400;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    if root.renaming: TextInput {
                        x: Theme.rename-pad;
                        y: Theme.rename-pad;
                        width: parent.width - 2 * Theme.rename-pad;
                        height: parent.height - 2 * Theme.rename-pad;
                        min-width: 1px;
                        font-size: 12px;
                        color: Theme.rename-text;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                            selection-background-color: Theme.selection-bg;
                            selection-foreground-color: Theme.selection-fg;
                            single-line: true;
                            edited => {
                                root.rename-edited(self.text);
                            }

                            init => {
                                root.rename-closing = false;
                                root.rename-had-focus = false;
                                self.text = root.rename-text;
                                self.focus();
                                self.select-all();
                            }

                            accepted => {
                                root.finish-rename-accept(self.text);
                            }

                            changed has-focus => {
                                if (self.has-focus) {
                                    root.rename-had-focus = true;
                                } else if (root.rename-had-focus && root.renaming && !root.rename-closing) {
                                    root.finish-rename-accept(self.text);
                                }
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    root.finish-rename-cancel();
                                    accept
                                } else {
                                    reject
                                }
                            }
                    }
                }

                Text {
                    text: root.subtitle;
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        // Action icons share one row so Path geometry aligns on a common baseline.
        if root.show-edit-launch || root.show-run-stop || root.show-refresh || root.show-close: VerticalLayout {
            horizontal-stretch: 0;
            vertical-stretch: 1;
            alignment: center;

            HorizontalLayout {
                spacing: 0;
                alignment: center;

                if root.show-edit-launch: TerminalRowIcon {
                    kind: "edit";
                    icon-opacity: root.renaming ? 0.0 : 1.0;
                    enabled: !root.renaming;
                    clicked => { root.edit-launch-clicked(); }
                    wheel(dy) => { root.wheel(dy); }
                }

                if root.show-run-stop: TerminalRowIcon {
                    kind: root.running ? "stop" : "play";
                    icon-opacity: root.renaming ? 0.0 : 1.0;
                    enabled: !root.renaming;
                    clicked => {
                        if (root.renaming) {
                            return;
                        }
                        if (root.running) {
                            root.stop-clicked();
                        } else {
                            root.run-clicked();
                        }
                    }
                    wheel(dy) => { root.wheel(dy); }
                }

                if root.show-refresh: TerminalRowIcon {
                    kind: "refresh";
                    icon-opacity: root.renaming ? 0.0 : 1.0;
                    enabled: !root.renaming;
                    clicked => { root.refresh-clicked(); }
                    wheel(dy) => { root.wheel(dy); }
                }

                if root.show-close: TerminalRowIcon {
                    kind: "close";
                    icon-opacity: root.renaming ? 0.0 : 1.0;
                    enabled: !root.renaming;
                    clicked => { root.close-clicked(); }
                    wheel(dy) => { root.wheel(dy); }
                }
            }
        }
    }
}

// Engine-synced scrollbar (std-widgets ScrollBar is not exported). Units match
// engine scroll_y / scroll_x (device pixels).
//
// Thumb geometry MUST match `noviewlog_core::scrollbar_math::thumb_offset_len`:
// travel = track - thumb_len where thumb_len = max(24px, track * page/range).
// Using fractional travel (1 - page/range) with a 24px min thumb overflows the
// track at value==maximum and paints into the status bar on large FILES.
export component EngineScrollBar inherits Rectangle {
    in property <bool> horizontal: false;
    in-out property <float> value: 0.0;
    in property <float> maximum: 0.0;
    in property <float> page-size: 1.0;
    in property <bool> enabled: true;
    callback scrolled(value: float);
    // Fired on left-button press (track or thumb) so hosts can dismiss inline
    // rename — "any pointer-down outside the field ends rename".
    callback press();

    background: Theme.bg-input;
    border-width: 0px;
    clip: true;
    // Layout parents must stretch us; default Rectangle preferred size is 0.
    vertical-stretch: root.horizontal ? 0 : 1;
    horizontal-stretch: root.horizontal ? 1 : 0;
    preferred-width: root.horizontal ? 0px : 10px;
    preferred-height: root.horizontal ? 10px : 0px;

    property <float> range: max(0.001, root.maximum + max(1.0, root.page-size));
    property <float> thumb-frac: root.maximum <= 0.5 ? 1.0 : min(1.0, max(1.0, root.page-size) / root.range);

    // Pixel track / thumb / travel (same as scrollbar_math).
    property <length> track-len: root.horizontal ? root.width : root.height;
    property <length> thumb-len: root.maximum <= 0.5
        ? root.track-len
        : min(root.track-len, max(24px, root.track-len * root.thumb-frac));
    property <length> travel-px: max(0px, root.track-len - root.thumb-len);
    property <length> thumb-offset: root.maximum <= 0.5
        ? 0px
        : root.travel-px * (clamp(root.value, 0.0, root.maximum) / max(0.001, root.maximum));

    thumb := Rectangle {
        width: root.horizontal ? root.thumb-len : parent.width - 4px;
        height: root.horizontal ? parent.height - 4px : root.thumb-len;
        x: root.horizontal ? root.thumb-offset : 2px;
        y: root.horizontal ? 2px : root.thumb-offset;
        border-radius: 4px;
        background: !root.enabled || root.maximum <= 0.5
            ? Theme.border
            : (touch.has-hover || touch.pressed ? Theme.text-secondary : Theme.text-muted);
    }

    touch := TouchArea {
        property <float> press-value: 0.0;
        property <float> press-mouse: 0.0;
        property <bool> dragging: false;

        width: 100%;
        height: 100%;
        enabled: root.enabled && root.maximum > 0.5;
        mouse-cursor: default;

        pointer-event(event) => {
            if (!root.enabled || root.maximum <= 0.5) {
                return;
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.press();
                self.press-value = root.value;
                self.press-mouse = root.horizontal ? self.mouse-x / 1px : self.mouse-y / 1px;
                self.dragging = true;

                // Click outside thumb: jump so thumb centers on click.
                if (root.horizontal) {
                    if (self.mouse-x < thumb.x || self.mouse-x > thumb.x + thumb.width) {
                        root.apply-ratio((self.mouse-x - thumb.width / 2) / max(1px, parent.width - thumb.width));
                        self.press-value = root.value;
                    }
                } else if (self.mouse-y < thumb.y || self.mouse-y > thumb.y + thumb.height) {
                    root.apply-ratio((self.mouse-y - thumb.height / 2) / max(1px, parent.height - thumb.height));
                    self.press-value = root.value;
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                self.dragging = false;
            }
        }

        moved => {
            if (!self.dragging || !self.pressed || !root.enabled || root.maximum <= 0.5) {
                return;
            }
            if (root.horizontal) {
                root.drag-to(self.press-value, self.press-mouse, self.mouse-x / 1px, parent.width / 1px, thumb.width / 1px);
            } else {
                root.drag-to(self.press-value, self.press-mouse, self.mouse-y / 1px, parent.height / 1px, thumb.height / 1px);
            }
        }

        scroll-event(event) => {
            if (!root.enabled || root.maximum <= 0.5) {
                return reject;
            }
            if (root.horizontal && event.delta-x / 1px != 0) {
                root.nudge(event.delta-x / 1px > 0 ? -40.0 : 40.0);
                return accept;
            }
            if (!root.horizontal && event.delta-y / 1px != 0) {
                root.nudge(event.delta-y / 1px > 0 ? -40.0 : 40.0);
                return accept;
            }
            reject
        }
    }

    function apply-ratio(ratio: float) {
        root.value = clamp(ratio, 0.0, 1.0) * root.maximum;
        root.scrolled(root.value);
    }

    function drag-to(press-value: float, press-mouse: float, mouse: float, track: float, thumb-len: float) {
        root.value = clamp(
            press-value + (mouse - press-mouse) * (root.maximum / max(1.0, track - thumb-len)),
            0.0,
            root.maximum,
        );
        root.scrolled(root.value);
    }

    function nudge(delta: float) {
        root.value = clamp(root.value + delta, 0.0, root.maximum);
        root.scrolled(root.value);
    }
}
