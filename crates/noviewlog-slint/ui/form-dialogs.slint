// Shared form-dialog chrome for Create/Rename/Edit launch/Settings/About.
// Square Theme borders only — never Theme.accent / fluent LineEdit focus bars.
// Buttons are AppButton (Theme + TouchArea) — never fluent std-widgets Button.
// Text inherits Window default-font-family (Noto Sans); icons use Path geometry.

import { Theme } from "theme.slint";

/// In-app dialog / form button. Theme chrome + proportional UI font for the label.
export component AppButton inherits TouchArea {
    in property <string> text: "";
    in property <bool> primary: false;

    height: Theme.field-height;
    min-width: 72px;
    horizontal-stretch: 0;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 0px;
        border-width: 1px;
        border-color: Theme.border;
        background: root.primary
            ? (root.pressed ? Theme.accent-pressed : (root.has-hover ? Theme.accent-hover : Theme.accent))
            : (root.pressed ? Theme.bg-input-active : (root.has-hover ? Theme.bg-input-hover : Theme.bg-input));
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;

        Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : Theme.text-primary;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

/// Labeled single-line field: label + square input chrome.
export component FormTextField inherits VerticalLayout {
    in property <string> label: "";
    in-out property <string> text: "";
    /// When true, focus the TextInput once after init (first field of a dialog).
    in property <bool> focus-on-init: false;
    callback accepted();
    callback cancelled();
    /// Tab/Shift+Tab traversal between dialog fields (issue #83).
    callback tab-move(shift: bool);

    public function take-focus() {
        field-edit.focus();
        field-edit.select-all();
    }

    spacing: 6px;
    width: 100%;

    Text {
        text: root.label;
        color: Theme.text-muted;
        font-size: 11px;
        font-weight: 700;
    }

    Rectangle {
        height: Theme.field-height;
        width: 100%;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: 0px;
        background: Theme.bg-input;
        clip: true;

        // Even inset on left, top, right, bottom — same as a normal Settings field.
        // Do not stretch TextInput to the border (glyphs then sit on the chrome).
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: Theme.field-pad-x;
            padding-right: Theme.field-pad-x;
            padding-top: Theme.field-pad-y;
            padding-bottom: Theme.field-pad-y;
            alignment: stretch;

            field-edit := TextInput {
                width: 100%;
                height: 100%;
                min-width: 1px;
                font-size: 12px;
                color: Theme.text-primary;
                horizontal-alignment: left;
                vertical-alignment: center;
                selection-background-color: Theme.selection-bg;
                selection-foreground-color: Theme.selection-fg;
                single-line: true;
                text <=> root.text;

                init => {
                    if (root.focus-on-init) {
                        self.focus();
                        self.select-all();
                    }
                }

                accepted => {
                    root.accepted();
                }

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.cancelled();
                        accept
                    } else if (event.text == Key.Tab) {
                        root.tab-move(event.modifiers.shift);
                        accept
                    } else {
                        reject
                    }
                }
            }
        }
    }

    public function focus-field() {
        field-edit.focus();
        field-edit.select-all();
    }
}

/// Labeled checkbox: Theme square + Path check (no fluent CheckBox, no Unicode glyphs).
export component FormCheckField inherits HorizontalLayout {
    in property <string> label: "";
    in-out property <bool> checked: false;

    spacing: 8px;
    width: 100%;
    height: Theme.field-height;
    alignment: start;

    TouchArea {
        width: 18px;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }

        Rectangle {
            width: 14px;
            height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.border;
            background: root.checked ? Theme.accent : Theme.bg-input;

            if root.checked: Path {
                width: 100%;
                height: 100%;
                stroke: Theme.text-primary;
                stroke-width: 1.25px;
                fill: transparent;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M 1.5 5 L 4 7.5 L 8.5 2.5";
            }
        }
    }

    TouchArea {
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }

        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

/// Titled panel with body `@children` and Cancel / primary footer.
export component FormDialogPanel inherits Rectangle {
    in property <string> title: "";
    in property <string> cancel-text: "Cancel";
    in property <string> ok-text: "OK";
    /// When false, hide Cancel (e.g. About with a single Close/OK).
    in property <bool> show-cancel: true;
    /// Windows Terminal-style footer: accent button on the left, Cancel right.
    in property <bool> footer-start: false;
    in property <length> panel-min-width: 420px;
    callback cancelled();
    callback confirmed();

    init => {
        // Issue #107: pull keyboard focus into the dialog when the popup is
        // shown, so Enter/Escape work immediately and keys cannot leak to the
        // viewport behind the dialog.
        dialog-keys.focus();
    }

    background: Theme.bg-window;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 0px;
    drop-shadow-color: Theme.shadow-panel;
    drop-shadow-offset-y: 8px;
    drop-shadow-blur: 20px;

    // Enter/Escape when focus is not in a text field (Settings SpinBox, About).
    // TextInput.accepted still handles Enter while typing.
    dialog-keys := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == Key.Return || event.text == "\n") {
                root.confirmed();
                accept
            } else if (event.text == Key.Escape) {
                root.cancelled();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            min-width: root.panel-min-width;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
            }

            VerticalLayout {
                spacing: 16px;
                width: 100%;
                @children
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: root.footer-start ? LayoutAlignment.start : LayoutAlignment.end;
                padding-top: 4px;

                if !root.footer-start && root.show-cancel: AppButton {
                    text: root.cancel-text;
                    clicked => { root.cancelled(); }
                }
                AppButton {
                    text: root.ok-text;
                    primary: true;
                    clicked => { root.confirmed(); }
                }
                if root.footer-start && root.show-cancel: AppButton {
                    text: root.cancel-text;
                    clicked => { root.cancelled(); }
                }
            }
        }
    }
}
